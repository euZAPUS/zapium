{
  "name": "zapium",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Portfolio personal de Álvaro Sánchez (euZAPUS).",
  "license": "MIT",
  "author": "euZAPUS",
  "repository": {
    "type": "git",
    "url": "https://github.com/euZAPUS/zapium.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "node scripts/optimize-images.mjs",
    "check:exif": "node scripts/check-exif.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm check:exif && pnpm build",
    "prepare": "git config core.hooksPath .githooks || true",
    "shots": "node scripts/shots.mjs",
    "videos": "node scripts/optimize-videos.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.5",
    "ogl": "^1.0.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
