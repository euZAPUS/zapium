---
import '~/styles/global.css';
import { SITE, type Locale } from '~/config/site';
import { homePath } from '~/i18n';
import { useT } from '~/i18n';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  locale?: Locale;
  /** Muestra la carga a modo de plano (solo la home). */
  intro?: boolean;
  title?: string;
  description?: string;
  /** Ruta de esta misma página en cada idioma (para hreflang). Por defecto, la home. */
  paths?: Record<Locale, string>;
}

const { locale = SITE.defaultLocale, intro = false, title, description, paths } = Astro.props;
const t = useT(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = SITE.locales.map((l) => ({
  l,
  href: new URL(paths?.[l] ?? homePath(l), Astro.site),
}));
---

<!doctype html>
<html lang={locale} data-intro={intro ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={description ?? t.meta.description} />
    <meta name="author" content="Álvaro Sánchez" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.l} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="preload" as="font" type="font/woff2" href={inter} crossorigin />
    <!-- Tema antes del primer pintado (sin parpadeo). El tema guardado solo vive en localStorage del visitante. -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          const saved = localStorage.getItem('theme');
          // Atributo PROPIO (data-mode): el Artifact de claude.ai pone su propio data-theme en <html> y pisaba el tema
          d.dataset.mode = saved === 'light' ? 'light' : 'dark';
          d.style.colorScheme = d.dataset.mode;
        } catch {
          /* sin localStorage: se usa el tema del sistema */
        }
        // Carga a modo de plano: en escritorio y móvil, sin reduced-motion y una vez por sesión (?intro la fuerza, ?nointro la quita)
        try {
          const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          const forced = location.search.includes('intro') && !location.search.includes('nointro');
          if (
            d.hasAttribute('data-intro') &&
            !calm &&
            !location.search.includes('nointro') &&
            (forced || !sessionStorage.getItem('zapium-intro'))
          ) {
            d.classList.add('is-loading');
          }
        } catch {
          /* sin sessionStorage: no se muestra la carga */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.nav.skip}
    </a>
    <slot />
    <div class="cursor" data-cursor-root aria-hidden="true">
      <svg class="cursor__ring" viewBox="-20 -20 40 40" focusable="false">
        <circle r="11"></circle>
        <path class="cursor__ticks" d="M0 -19V-14M0 14V19M-19 0H-14M14 0H19"></path>
      </svg>
      <span class="cursor__dot"></span>
    </div>
    <script>
      import '~/scripts/ui';
      import '~/scripts/cursor';
      import '~/scripts/preloader';
      import '~/scripts/hud';
      import '~/scripts/hero';
      import '~/scripts/potato';
      import '~/scripts/world';
      import '~/scripts/world/gizmo';
      import '~/scripts/story';
      import '~/scripts/works';
      import '~/scripts/demo';
      import '~/scripts/potato/contact';
    </script>
  </body>
</html>
