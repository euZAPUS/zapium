---
import '~/styles/global.css';
import { SITE, type Locale } from '~/config/site';
import { homePath } from '~/i18n';
import { useT } from '~/i18n';
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  locale?: Locale;
}

const { locale = SITE.defaultLocale } = Astro.props;
const t = useT(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = SITE.locales.map((l) => ({ l, href: new URL(homePath(l), Astro.site) }));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content="Álvaro Sánchez" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.l} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={bricolage} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter} crossorigin />
    <!-- Tema antes del primer pintado (sin parpadeo). El tema guardado solo vive en localStorage del visitante. -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') d.dataset.theme = saved;
        } catch {
          /* sin localStorage: se usa el tema del sistema */
        }
        // Vista previa de la paleta B (solo mientras se decide la dirección visual)
        const p = new URLSearchParams(location.search).get('p');
        if (p === 'b') d.dataset.palette = 'b';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.nav.skip}
    </a>
    <slot />
    <div class="cursor" data-cursor-root aria-hidden="true">
      <div class="cursor__ring"></div>
      <div class="cursor__dot"></div>
    </div>
    <script>
      import '~/scripts/ui';
      import '~/scripts/cursor';
      import '~/scripts/potato';
      import '~/scripts/hero';
    </script>
  </body>
</html>
