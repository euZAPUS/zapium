---
import '~/styles/global.css';
import { SITE, type Locale } from '~/config/site';
import { homePath } from '~/i18n';
import { useT } from '~/i18n';
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  locale?: Locale;
  /** Muestra la carga a modo de plano (solo la home). */
  intro?: boolean;
}

const { locale = SITE.defaultLocale, intro = false } = Astro.props;
const t = useT(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = SITE.locales.map((l) => ({ l, href: new URL(homePath(l), Astro.site) }));
---

<!doctype html>
<html lang={locale} data-intro={intro ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content="Álvaro Sánchez" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.l} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="preload" as="font" type="font/woff2" href={bricolage} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter} crossorigin />
    <!-- Tema antes del primer pintado (sin parpadeo). El tema guardado solo vive en localStorage del visitante. -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          const saved = localStorage.getItem('theme');
          d.dataset.theme = saved === 'light' ? 'light' : 'dark';
        } catch {
          /* sin localStorage: se usa el tema del sistema */
        }
        // Carga a modo de plano: solo escritorio, sin reduced-motion y una vez por sesión (?intro la fuerza)
        try {
          const wide = matchMedia(
            '(min-width: 52rem) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
          ).matches;
          const forced = location.search.includes('intro') && !location.search.includes('nointro');
          if (
            d.hasAttribute('data-intro') &&
            wide &&
            !location.search.includes('nointro') &&
            (forced || !sessionStorage.getItem('zapium-intro'))
          ) {
            d.classList.add('is-loading');
          }
        } catch {
          /* sin sessionStorage: no se muestra la carga */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.nav.skip}
    </a>
    <slot />
    <div class="cursor" data-cursor-root aria-hidden="true">
      <div class="cursor__glow"></div>
      <svg class="cursor__hand" viewBox="0 0 64 64" focusable="false">
        <path d="M23 13c0-5 9-5 9 0v15c2-2 8-2 9 1 3-1 8 0 8 4 3 0 6 3 5 7l-1 8c-1 7-5 12-12 12H29c-6 0-11-4-13-9l-5-11c-2-4 3-7 6-4l6 6z"></path>
        <path class="cursor__knuckles" d="M32 29v9M41 30v8M49 34v7"></path>
      </svg>
    </div>
    <script>
      import '~/scripts/ui';
      import '~/scripts/cursor';
      import '~/scripts/preloader';
      import '~/scripts/hud';
      import '~/scripts/hero';
      import '~/scripts/world';
      import '~/scripts/world/gizmo';
      import '~/scripts/story';
    </script>
  </body>
</html>
