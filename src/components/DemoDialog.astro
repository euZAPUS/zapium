---
/**
 * <dialog> modal compartido por las demos jugables y los tráilers de los proyectos (se pinta UNA vez, en Works).
 * Los botones que lo abren son DemoButton.astro (`data-demo-open` + título, nota y ruta). Reglas (CLAUDE.md →
 * Presupuestos): el iframe se crea SOLO al hacer clic (scripts/demo.ts), lleva `sandbox="allow-scripts …"` SIN
 * `allow-same-origin` (origen opaco: no puede tocar esta página ni su almacenamiento) y se destruye al cerrar para
 * parar el temporizador, los bucles y el audio de la demo. Las demos viven en public/demos/NOMBRE/ (un HTML único,
 * todo inline, sin red, sin guardar nada). Los tráilers (vídeo con sonido) en public/trailers/.
 */
import Icon from './Icon.astro';

interface Props {
  /** Idioma que se le pasa a las demos (?lang=) */
  lang: string;
  close: string;
  loading: string;
  error: string;
}
const { lang, close, loading, error } = Astro.props;
---

<dialog
  class="demo"
  data-demo-dialog
  data-lang={lang}
  data-loading={loading}
  data-error={error}
  aria-labelledby="demo-title"
>
  <header class="demo__bar">
    <div>
      <p id="demo-title" class="demo__title" data-demo-title></p>
      <p class="demo__note" data-demo-note></p>
    </div>
    <button type="button" class="btn btn--small" data-demo-close>
      <Icon name="close" />
      {close}
    </button>
  </header>
  <div class="demo__body" data-demo-body></div>
</dialog>

<style is:global>
  dialog.demo {
    width: min(74rem, 96vw);
    height: min(60rem, 94dvh);
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    overflow: hidden;
    color: var(--ink);
    background: var(--surface);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-hard-lg);
  }
  dialog.demo[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  dialog.demo::backdrop {
    background: rgb(10 8 6 / 0.72);
    backdrop-filter: blur(6px);
  }
  .demo__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border-w) solid var(--line);
    background: var(--bg-soft);
  }
  .demo__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-m);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .demo__note {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  .demo__body {
    position: relative;
    min-height: 0;
    background: #050506;
  }
  .demo__msg {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: var(--space-5);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }
  /* Tráiler: el diálogo se ajusta a un 16:9 en vez de ocupar toda la altura */
  dialog.demo[data-kind='video'] {
    width: min(64rem, 96vw);
    height: auto;
  }
  dialog.demo[data-kind='video'] .demo__body {
    aspect-ratio: 16 / 9;
  }
  .demo__body video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    background: #000;
  }
  .demo__body iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    border: 0;
  }
  /* La mano personalizada no entra en el iframe: dentro del diálogo se usa el cursor nativo */
  html.has-cursor dialog.demo,
  html.has-cursor dialog.demo * {
    cursor: auto;
  }
  html.has-cursor dialog.demo button {
    cursor: pointer;
  }
  html.is-demo {
    overflow: hidden;
  }
  html.is-demo .cursor {
    opacity: 0;
  }
  /* Móvil: a pantalla completa */
  @media (max-width: 40rem) {
    dialog.demo {
      width: 100vw;
      height: 100dvh;
      border-radius: 0;
      border-width: 0;
      box-shadow: none;
    }
    dialog.demo[data-kind='video'] {
      width: 100vw;
      height: auto;
      margin-block: auto;
    }
  }
</style>
