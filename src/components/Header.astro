---
import type { Locale } from '~/config/site';
import { homePath, labPath, otherLocale, useT } from '~/i18n';
import Icon from './Icon.astro';
import logo from '~/assets/avatar/logo.png';

interface Props {
  locale: Locale;
  /** En la home los enlaces son anclas; en otras páginas llevan a la home. */
  current?: 'home' | 'lab';
  /** Ruta de esta misma página en cada idioma (selector de idioma). */
  paths?: Record<Locale, string>;
}
const { locale, current = 'home', paths } = Astro.props;
const prefix = current === 'home' ? '' : homePath(locale);
const t = useT(locale);
const other = otherLocale(locale);
const links = [
  { href: `${prefix}#projects`, label: t.nav.projects },
  { href: `${prefix}#about`, label: t.nav.about },
  { href: `${prefix}#ai`, label: t.nav.ai },
  { href: `${prefix}#stack`, label: t.nav.stack },
  { href: labPath(locale), label: t.nav.lab },
] as const;
---

<header class="header" data-header>
  <div class="container header__bar">
    <a class="brand" href={homePath(locale)} aria-label={`zapium — ${t.nav.home}`}>
      <img class="brand__logo" src={logo.src} width={logo.width} height={logo.height} alt="" />
      <span class="brand__name">zapium</span>
    </a>

    <nav class="nav" id="site-nav" aria-label={t.nav.label} data-nav>
      <ul class="nav__links">
        {links.map((l) => (
          <li>
            <a href={l.href} class="nav__link">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav__tools">
        <a
          class="tool"
          href={paths?.[other] ?? homePath(other)}
          hreflang={other}
          lang={other}
          aria-label={t.ui.langSwitchTo}
          data-lang-switch
        >
          {t.ui.langCode}
        </a>
        <button
          class="tool"
          type="button"
          data-sound-toggle
          data-label-on={t.ui.soundOn}
          data-label-off={t.ui.soundOff}
          aria-pressed="false"
          aria-label={t.ui.soundOn}
        >
          <Icon name="sound-off" class="tool__soff" />
          <Icon name="sound-on" class="tool__son" />
        </button>
        <button
          class="tool"
          type="button"
          data-theme-toggle
          data-label-to-light={t.ui.themeToLight}
          data-label-to-dark={t.ui.themeToDark}
          aria-label={t.ui.themeToDark}
        >
          <Icon name="sun" class="tool__sun" />
          <Icon name="moon" class="tool__moon" />
        </button>
      </div>
    </nav>

    <div class="header__cta">
      <a
        class="btn btn--small"
        href="/assets/cv.pdf"
        data-cursor="link"
        aria-disabled="true"
        title={t.ui.cvSoon}
        data-cv
      >
        <Icon name="download" />
        {t.nav.cv}
      </a>
      <a class="btn btn--small btn--primary" href={`${prefix}#contact`} data-cursor="link">
        <Icon name="mail" />
        <span class="header__contact">{t.nav.contact}</span>
      </a>
      <button
        class="tool menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-btn
        data-label-open={t.nav.menuOpen}
        data-label-close={t.nav.menuClose}
        aria-label={t.nav.menuOpen}
      >
        <Icon name="menu" class="menu-btn__open" />
        <Icon name="close" class="menu-btn__close" />
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: var(--border-w) solid var(--line-soft);
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .header__bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-l);
    letter-spacing: -0.04em;
  }
  .brand__logo {
    width: 2.6rem;
    height: 2.1rem;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-inline-start: auto;
  }
  .nav__links {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-block: var(--space-2);
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 0.18em no-repeat;
    transition: background-size var(--dur-base) var(--ease-out);
  }
  .nav__link:hover {
    background-size: 100% 0.18em;
  }
  .nav__tools {
    display: flex;
    gap: var(--space-2);
  }
  .header__cta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .tool {
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 var(--space-2);
    background: transparent;
    color: var(--ink);
    border: var(--border-w) solid var(--line-soft);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .tool:hover {
    border-color: var(--ink);
    background: color-mix(in srgb, var(--ink) 9%, transparent);
  }
  .tool :global(.tool__moon),
  .menu-btn :global(.menu-btn__close) {
    display: none;
  }
  :global(:root[data-mode='light']) .tool :global(.tool__sun) {
    display: block;
  }
  :global(:root[data-mode='light']) .tool :global(.tool__moon) {
    display: none;
  }
  .tool :global(.tool__sun) {
    display: none;
  }
  .tool :global(.tool__son) {
    display: none;
  }
  .tool[aria-pressed='true'] :global(.tool__son) {
    display: block;
  }
  .tool[aria-pressed='true'] :global(.tool__soff) {
    display: none;
  }
  .tool :global(.tool__moon) {
    display: block;
  }
  .menu-btn {
    display: none;
  }
  .menu-btn[aria-expanded='true'] :global(.menu-btn__open) {
    display: none;
  }
  .menu-btn[aria-expanded='true'] :global(.menu-btn__close) {
    display: block;
  }

  /* Móvil/tablet: el menú se pliega, CV y Contacto siempre visibles */
  @media (max-width: 66rem) {
    .menu-btn {
      display: inline-grid;
    }
    .header__cta {
      margin-inline-start: auto;
    }
    :global(html.js) .nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-5);
      margin: 0;
      padding: var(--space-5) var(--gutter) var(--space-6);
      background: var(--bg);
      border-bottom: var(--border-w) solid var(--line-soft);
      translate: 0 -120%;
      visibility: hidden;
      transition:
        translate var(--dur-base) var(--ease-out),
        visibility 0s var(--dur-base);
    }
    :global(html.js) .nav[data-open] {
      translate: 0 0;
      visibility: visible;
      transition: translate var(--dur-base) var(--ease-out);
    }
    .nav__links {
      flex-direction: column;
      gap: var(--space-2);
    }
    .nav__link {
      display: block;
      padding-block: var(--space-3);
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: 400;
    }
    .nav__tools {
      justify-content: flex-start;
    }
    :global(html:not(.js)) .nav {
      display: none;
    }
    :global(html:not(.js)) .menu-btn {
      display: none;
    }
  }
  @media (max-width: 26rem) {
    .header__contact {
      display: none;
    }
    .header__cta .btn {
      padding-inline: var(--space-3);
    }
  }
</style>
