---
/**
 * La patata del autor, con SU dibujo original: tres capas cortadas del PNG sin
 * retocar (cuerpo + dos brazos; ver scripts/split-avatar.mjs). En reposo se ve
 * exactamente igual que el original. Los brazos se animan (saludo, choca esos cinco);
 * el cuerpo salta, se inclina hacia el cursor y reacciona al clic.
 * Slot `hat`: sombrero/accesorio encima del cuerpo (fase 5).
 */
import body from '~/assets/avatar/body.png';
import armL from '~/assets/avatar/arm-l.png';
import armR from '~/assets/avatar/arm-r.png';

interface Props {
  alt?: string;
  buttonLabel?: string;
  class?: string;
  /** Versión «guía» de las escenas: decorativa, sin clic y sin caída de entrada. */
  guide?: boolean;
}
const { alt = '', buttonLabel = '', class: className, guide = false } = Astro.props;
const Tag = (guide ? 'span' : 'button') as 'button';
const attrs: astroHTML.JSX.ButtonHTMLAttributes = guide
  ? { 'aria-hidden': 'true' }
  : { type: 'button', 'aria-label': buttonLabel, 'data-mascot': '', 'data-cursor': 'link' };
---

<Tag class:list={['mascot', { 'mascot--guide': guide }, className]} {...attrs}>
  <span class="mascot__fall">
    <span class="mascot__tilt">
      <span class="mascot__bob">
        <img
          class="mascot__layer mascot__arm mascot__arm--l"
          src={armL.src}
          width={armL.width}
          height={armL.height}
          alt=""
        />
        <img
          class="mascot__layer mascot__arm mascot__arm--r"
          src={armR.src}
          width={armR.width}
          height={armR.height}
          alt=""
        />
        <img
          class="mascot__layer mascot__body"
          src={body.src}
          width={body.width}
          height={body.height}
          alt={guide ? '' : alt}
          fetchpriority={guide ? undefined : 'high'}
        />
        <span class="mascot__hat">
          <slot name="hat" />
        </span>
      </span>
    </span>
  </span>
  <!-- Zona de clic: solo el cuerpo, para no tapar lo que hay detrás de los brazos -->
  {!guide && <span class="mascot__hit" aria-hidden="true" />}
</Tag>

<style>
  .mascot {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1506 / 549;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: none; /* la zona de clic es .mascot__hit */
    -webkit-tap-highlight-color: transparent;
  }
  .mascot__hit {
    position: absolute;
    inset: 4% 19.5% 2% 33%;
    pointer-events: auto;
    border-radius: 40%;
  }
  .mascot__fall,
  .mascot__tilt,
  .mascot__bob {
    position: absolute;
    inset: 0;
    display: block;
  }
  /* Todas las capas miden lo mismo y se apilan: al superponerse dan el dibujo original */
  .mascot__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }
  .mascot__body {
    filter: drop-shadow(0 1.1rem 0.9rem rgb(0 0 0 / 0.18));
  }

  /* Inclinación hacia el cursor (variables que escribe hero/interact.ts) */
  .mascot__tilt {
    rotate: calc(var(--tilt-x, 0) * 4deg);
    translate: calc(var(--tilt-x, 0) * 1.2%) calc(var(--tilt-y, 0) * 1.6%);
    transition:
      rotate 0.3s var(--ease-out),
      translate 0.3s var(--ease-out);
  }

  /* Versión guía: sin caída de entrada (la coreografía la lleva la escena) */
  .mascot--guide .mascot__fall {
    animation: none;
  }
  .mascot--guide {
    display: block;
  }

  /* Caída de entrada con rebote y aplastamiento */
  .mascot__fall {
    transform-origin: 50% 100%;
    animation: fall 1.25s both;
    animation-delay: var(--intro, 0ms);
  }
  @keyframes fall {
    0% {
      translate: 0 -115vh;
      scale: 0.86 1.22;
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.6);
    }
    38% {
      translate: 0 0;
      scale: 1.2 0.8;
      animation-timing-function: var(--ease-out);
    }
    52% {
      translate: 0 -14%;
      scale: 0.93 1.1;
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.6);
    }
    66% {
      translate: 0 0;
      scale: 1.08 0.93;
      animation-timing-function: var(--ease-out);
    }
    80% {
      translate: 0 -3%;
      scale: 0.98 1.03;
    }
    100% {
      translate: 0 0;
      scale: 1 1;
    }
  }

  /* Reposo: respira, se balancea y mueve los brazos */
  .mascot__bob {
    transform-origin: 50% 100%;
    animation: bob 4.2s var(--ease-in-out) infinite;
    animation-delay: calc(var(--intro, 0ms) + 1.3s);
  }
  @keyframes bob {
    50% {
      translate: 0 -2.2%;
      rotate: 1.4deg;
      scale: 1.012 0.99;
    }
  }
  .mascot__arm {
    animation: wave 2.4s var(--ease-in-out) infinite;
    animation-delay: calc(var(--intro, 0ms) + 1.1s);
  }
  .mascot__arm--l {
    transform-origin: 33.2% 44.3%; /* hombro izquierdo en el dibujo */
  }
  .mascot__arm--r {
    transform-origin: 80.1% 58.5%; /* hombro derecho */
    animation-delay: calc(var(--intro, 0ms) + 1.9s);
  }
  @keyframes wave {
    0%,
    100% {
      rotate: 0deg;
    }
    50% {
      rotate: -9deg;
    }
  }
  .mascot__arm--r {
    animation-name: wave-r;
  }
  @keyframes wave-r {
    0%,
    100% {
      rotate: 0deg;
    }
    50% {
      rotate: 9deg;
    }
  }

  /* Saludo grande al aterrizar y al pasar el ratón */
  .mascot:hover .mascot__arm,
  .mascot.is-greeting .mascot__arm {
    animation-duration: 0.45s;
  }

  /* Clic: salto con voltereta */
  .mascot.is-jumping .mascot__fall {
    animation: jump 0.7s both;
  }
  @keyframes jump {
    0% {
      scale: 1.14 0.86;
    }
    35% {
      translate: 0 -34%;
      rotate: -8deg;
      scale: 0.92 1.12;
    }
    70% {
      translate: 0 0;
      rotate: 4deg;
      scale: 1.12 0.9;
    }
    100% {
      translate: 0 0;
      rotate: 0deg;
      scale: 1 1;
    }
  }
  /* Muchos clics seguidos: se marea */
  .mascot.is-dizzy .mascot__fall {
    animation: dizzy 1.1s var(--ease-in-out) both;
  }
  @keyframes dizzy {
    0% {
      rotate: 0deg;
    }
    40% {
      rotate: 540deg;
      translate: 0 -22%;
    }
    100% {
      rotate: 720deg;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot__fall,
    .mascot__bob,
    .mascot__arm {
      animation: none !important;
    }
  }
</style>
