---
/**
 * «Works»: los proyectos como pantallas curvas (WebGL, scripts/works) sobre una hoja con rejilla que
 * se dobla en ola con el scroll. Cada proyecto es un <li> con su texto real (DOM) y su origen visual:
 * vídeo (public/videos/NAME.*, lo genera `pnpm videos`), captura (public/works/NAME.webp, lo genera
 * `node scripts/capture-works.mjs`) o, si no hay nada, un marcador [TODO] visible.
 * - Con WebGL y sin reduced-motion: la sección se fija y el scroll recorre las pantallas (`data-gl`).
 * - Si no: lista apilada normal (imagen + texto), que es también el contenido que lee un buscador.
 * Debajo, «Más proyectos»: índice en filas, estilo editorial.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { PERSON, type Locale } from '~/config/site';
import { labPath, useT } from '~/i18n';
import Icon, { type IconName } from './Icon.astro';
import Guide from './Guide.astro';
import ProofVideo from './ProofVideo.astro';
import DemoDialog from './DemoDialog.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = useT(locale).story.projects;
const byId = Object.fromEntries(s.items.map((i) => [i.id, i]));
const isPublic = (p: string) => existsSync(join(process.cwd(), 'public', p));

// OJO: `zapper-aio` es PRIVADO (404 para los visitantes). Solo se enlaza lo público.
const repo = `${PERSON.github}/zapper-aio-releases`;
const releases = `${PERSON.github}/zapper-aio-releases/releases/latest`;
const lab = labPath(locale);
const demoSrc = '/demos/huerto/index.html';
const hasDemo = isPublic(demoSrc);

interface Link {
  label: string;
  href: string;
  icon: IconName;
  primary?: boolean;
}
interface Work {
  id: string;
  tag: string;
  title: string;
  body: string;
  facts?: readonly { k: string; v: string }[];
  /** Nombre base en public/videos/ si hay vídeo; captura en public/works/ si la hay */
  video?: string;
  img?: string;
  placeholder: string;
  demo?: boolean;
  links: Link[];
}

const media = (id: string, video?: string) => ({
  video: video && isPublic(`videos/${video}.webm`) ? video : undefined,
  img: isPublic(`works/${id}.webp`) ? `/works/${id}.webp` : undefined,
});
const labWork = (id: 'subnet' | 'bits' | 'risk'): Work => {
  const it = byId[id]!;
  return {
    id,
    tag: it.tag,
    title: it.title,
    body: it.body,
    ...media(id),
    placeholder: `[TODO] ${it.title}`,
    links: [{ label: it.cta, href: `${lab}#${id}`, icon: 'arrow', primary: true }],
  };
};
const huerto = byId.huerto!;
const works: Work[] = [
  {
    id: 'zapper',
    tag: s.tag,
    title: s.title,
    body: s.summary,
    facts: s.facts,
    ...media('zapper', 'zapper-aio'),
    placeholder: s.videoTodo,
    links: [
      { label: s.download, href: releases, icon: 'download', primary: true },
      { label: s.repo, href: repo, icon: 'branch' },
    ],
  },
  {
    id: 'huerto',
    tag: huerto.tag,
    title: huerto.title,
    body: huerto.body,
    ...media('huerto', 'zapper-huerto'),
    placeholder: `[TODO] ${huerto.title}`,
    demo: hasDemo,
    links: [{ label: s.download, href: releases, icon: 'download', primary: !hasDemo }],
  },
  labWork('subnet'),
  labWork('bits'),
  labWork('risk'),
];

const moreHref: Record<string, string> = {
  libft: `${PERSON.github}/Campus42`,
  zapium: `${PERSON.github}/zapium`,
  dropshipping: '#about',
  trading: '#about',
  github: PERSON.github,
};
const more = ['libft', 'zapium', 'dropshipping', 'trading', 'github']
  .map((id) => byId[id])
  .filter((x): x is NonNullable<typeof x> => !!x);
const nn = (n: number) => String(n).padStart(2, '0');
---

<section
  class="works"
  id="projects"
  aria-labelledby="projects-title"
  data-works
  style={`--n:${works.length}`}
>
  <div class="works__stick">
    <div class="works__stage" data-works-stage aria-hidden="true"></div>

    <header class="works__head container">
      <h2 id="projects-title" class="works__label">
        <span>{s.eyebrow}</span>
        <i aria-hidden="true">/</i>
        <span class="works__sub">{s.wallTitle}</span>
      </h2>
      <p class="works__count" aria-hidden="true">
        <b data-works-current>01</b>
        <span> / {nn(works.length)}</span>
      </p>
    </header>

    <ol class="works__list container" aria-label={s.screensLabel}>
      {works.map((w, i) => (
        <li
          class="work"
          id={`work-${w.id}`}
          data-work
          data-img={w.img}
          data-video={w.video ? `/videos/${w.video}` : undefined}
          data-poster={w.video ? `/videos/${w.video}.jpg` : undefined}
          data-ph={w.placeholder}
          style={`--i:${i}`}
        >
          <div class="work__media">
            {w.video ? (
              <ProofVideo src={w.video} label={w.placeholder} title={w.title} />
            ) : w.img ? (
              <div class="shot">
                <img
                  src={w.img}
                  alt={w.title}
                  width="1280"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : (
              <ProofVideo label={w.placeholder} title={w.title} />
            )}
          </div>
          <div class="work__info">
            <p class="work__num">
              <b>{nn(i + 1)}</b>
              <span> / {nn(works.length)}</span>
            </p>
            <p class="tag">{w.tag}</p>
            <h3 class="work__title">{w.title}</h3>
            <p class="work__body">{w.body}</p>
            {w.facts && (
              <dl class="facts">
                {w.facts.map((f) => (
                  <>
                    <dt>{f.k}</dt>
                    <dd>{f.v}</dd>
                  </>
                ))}
              </dl>
            )}
            <div class="work__links">
              {w.demo && (
                <DemoDialog
                  src={demoSrc}
                  lang={locale}
                  label={s.demo}
                  title={s.demoTitle}
                  note={s.demoNote}
                  close={s.demoClose}
                />
              )}
              {w.links.map((l) => (
                <a
                  class:list={['btn', 'btn--small', { 'btn--primary': l.primary }]}
                  href={l.href}
                  data-cursor="link"
                >
                  <Icon name={l.icon} />
                  {l.label}
                </a>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>

    <nav class="works__nav" aria-label={s.navLabel}>
      <ol>
        {works.map((w, i) => (
          <li>
            <button
              type="button"
              data-works-go
              aria-current={i === 0 ? 'true' : 'false'}
              data-cursor="link"
            >
              <span>{nn(i + 1)}</span>
              <span class="sr-only">{w.title}</span>
            </button>
          </li>
        ))}
      </ol>
    </nav>
    <p class="works__hint" aria-hidden="true">
      {s.explore} <Icon name="arrow" />
    </p>
    <Guide class="guide--works" text={s.wallBubble} />
    <div class="works__progress" aria-hidden="true">
      <i></i>
    </div>
  </div>
</section>

<section class="more container" aria-labelledby="more-title">
  <h3 id="more-title" class="more__title">
    {s.more}
  </h3>
  <ul class="more__list">
    {more.map((m, n) => (
      <li>
        <a class="more__row" href={moreHref[m.id]} data-cursor="link">
          <span class="more__n">{nn(works.length + n + 1)}</span>
          <span class="more__name">{m.title}</span>
          <span class="more__tag">{m.tag}</span>
          <span class="more__desc">{m.body}</span>
          <Icon name="arrow" class="more__arr" />
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* ───────── Base (sin WebGL / reduced-motion): lista apilada ───────── */
  .works {
    position: relative;
    padding-block: var(--space-8) var(--space-6);
    --hp: 0; /* progreso 0 → 1 (scripts/works) */
    --ai: 0; /* índice activo */
  }
  .works__stage,
  .works__nav,
  .works__hint,
  .works__progress,
  .works :global(.guide--works) {
    display: none;
  }
  .works__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .works__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .works__label span {
    color: var(--ink);
  }
  .works__label .works__sub {
    color: var(--ink-muted);
  }
  .works__label i {
    margin-inline: 0.7em;
    font-style: normal;
    color: var(--accent);
  }
  .works__count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--ink-muted);
  }
  .works__count b {
    color: var(--ink);
    font-weight: 500;
  }
  .works__list {
    display: grid;
    gap: var(--space-8);
    margin-block: 0;
    padding: 0;
    list-style: none;
  }
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-6) var(--space-7);
    align-items: center;
  }
  .shot {
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-s);
    overflow: hidden;
    background: var(--bg-soft);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .work__info {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .work__num {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--ink-muted);
  }
  .work__num b {
    color: var(--ink);
    font-weight: 500;
  }
  .work__title {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.6rem);
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .work__body {
    margin: 0;
    max-width: 38ch;
    color: var(--ink-muted);
    font-size: var(--text-m);
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-2) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-soft);
    font-size: var(--text-xs);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: 0.12rem;
  }
  .facts dd {
    margin: 0;
  }
  .work__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  /* ───────── «Más proyectos»: índice en filas ───────── */
  .more {
    padding-block: var(--space-7) var(--space-8);
  }
  .more__title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .more__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-soft);
  }
  .more__row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.1fr) minmax(0, 0.8fr) minmax(0, 2fr) 1.5rem;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line-soft);
    color: var(--ink);
    text-decoration: none;
    transition: padding-inline var(--dur-base) var(--ease-out);
  }
  .more__row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent);
    scale: 1 0;
    transition: scale var(--dur-base) var(--ease-out);
  }
  .more__row:hover,
  .more__row:focus-visible {
    padding-inline-start: var(--space-4);
  }
  .more__row:hover::before,
  .more__row:focus-visible::before {
    scale: 1 1;
  }
  .more__n,
  .more__tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .more__name {
    font-family: var(--font-display);
    font-size: var(--text-l);
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .more__desc {
    color: var(--ink-muted);
    font-size: var(--text-s);
  }
  .more :global(.more__arr) {
    width: 1.1rem;
    height: 1.1rem;
    justify-self: end;
    transition: translate var(--dur-base) var(--ease-out);
  }
  .more__row:hover :global(.more__arr) {
    translate: 0.3rem 0;
  }

  /* ───────── Con WebGL: sección fijada, pantallas dobladas ───────── */
  .works[data-gl] {
    height: calc(100svh + (var(--n) - 1) * 88svh);
    padding: 0;
  }
  .works[data-gl] .works__stick {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
  }
  .works[data-gl] .works__stage {
    display: block;
    position: absolute;
    inset: 0;
    background: var(--bg);
  }
  .works__stage :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .works[data-gl] .works__head {
    position: absolute;
    z-index: 2;
    inset: calc(var(--header-h) + 1.1rem) 9rem auto var(--gutter);
    margin: 0;
    padding-inline-start: max(0rem, calc(5.5rem - var(--gutter)));
    width: auto;
    max-width: none;
    pointer-events: none;
  }
  .works[data-gl] .works__list {
    position: absolute;
    inset: 0;
    display: block;
    width: auto;
    max-width: none;
    margin: 0;
    pointer-events: none;
  }
  .works[data-gl] .work {
    position: absolute;
    inset: 0;
    display: block;
  }
  .works[data-gl] .work__media {
    display: none;
  }
  .works[data-gl] .work__info {
    position: absolute;
    z-index: 2;
    right: max(var(--gutter), 4.5vw);
    top: 50%;
    width: min(30rem, 31vw);
    translate: 0 calc(-50% + 1.4rem);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    text-shadow: 0 0 1.2rem var(--bg);
    isolation: isolate;
    transition:
      opacity 0.5s var(--ease-out),
      translate 0.7s var(--ease-out),
      visibility 0s linear 0.5s;
  }
  /* velo detrás del texto: la pantalla vecina asoma por la derecha y no debe restar legibilidad */
  .works[data-gl] .work__info::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -3rem -4rem -3rem -3rem;
    background: radial-gradient(
      ellipse closest-side,
      color-mix(in srgb, var(--bg) 82%, transparent),
      transparent
    );
  }
  .works[data-gl] .work[data-active] .work__info {
    translate: 0 -50%;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.6s var(--ease-out) 0.12s,
      translate 0.8s var(--ease-out) 0.12s,
      visibility 0s;
  }
  .works[data-gl] .work__title {
    font-size: clamp(2rem, 1rem + 2.7vw, 3.8rem);
  }
  .works[data-gl] .works__nav {
    display: block;
    position: absolute;
    z-index: 3;
    right: max(var(--gutter), 4.5vw);
    bottom: 2.1rem;
  }
  .works__nav ol {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .works__nav button {
    padding: 0.35rem 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line-soft);
    cursor: pointer;
    transition:
      color var(--dur-base),
      border-color var(--dur-base);
  }
  .works__nav button:hover,
  .works__nav button[aria-current='true'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .works[data-gl] .works__hint {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    position: absolute;
    z-index: 3;
    left: 50%;
    translate: -50% 0;
    bottom: 2.1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    opacity: clamp(0, calc(1 - var(--hp) * 14), 1);
  }
  .works__hint :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .works[data-gl] .works__progress {
    display: block;
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--line-soft);
  }
  .works__progress i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    scale: var(--hp) 1;
  }
  .works[data-gl] :global(.guide--works) {
    display: block;
    position: absolute;
    z-index: 3;
    left: 14rem;
    bottom: 0.7rem;
    width: 5.2rem;
    translate: calc(var(--hp) * (100vw - 100% - 17rem)) calc(sin(var(--hp) * 18.85rad) * -0.4rem);
    pointer-events: none;
  }
  .works :global(.guide--works .guide__spin) {
    transform: perspective(700px) rotateY(calc(var(--hp) * 1080deg));
  }
  .works :global(.guide--works .guide__bubble) {
    bottom: 92%;
    opacity: min(
      clamp(0, calc((var(--hp) - 0.02) * 20), 1),
      clamp(0, calc((0.2 - var(--hp)) * 20), 1)
    );
  }

  /* Vertical (móvil): la pantalla arriba y el texto debajo */
  @media (max-aspect-ratio: 1/1) {
    .works[data-gl] .work__info {
      top: auto;
      left: var(--gutter);
      right: var(--gutter);
      bottom: 4.4rem;
      width: auto;
      translate: 0 1.2rem;
    }
    .works[data-gl] .work[data-active] .work__info {
      translate: 0 0;
    }
    .works[data-gl] .work__title {
      font-size: clamp(1.7rem, 7.5vw, 2.4rem);
    }
    .works[data-gl] .work__body {
      font-size: var(--text-s);
      display: -webkit-box;
      -webkit-line-clamp: 4;
      line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .works[data-gl] .facts {
      display: none;
    }
    .works[data-gl] .works__head {
      padding-inline-start: 0;
      right: var(--gutter);
    }
    .works[data-gl] .works__sub,
    .works[data-gl] .works__label i {
      display: none;
    }
    .works[data-gl] .works__nav {
      left: var(--gutter);
      bottom: 1.4rem;
    }
    .works[data-gl] .works__hint,
    .works[data-gl] :global(.guide--works) {
      display: none;
    }
  }
  /* Con poca altura (portátiles bajos) se compacta el texto */
  @media (max-height: 52rem) and (min-aspect-ratio: 1/1) {
    .works[data-gl] .work__body {
      font-size: var(--text-s);
    }
    .works[data-gl] .facts {
      display: none;
    }
  }

  @media (max-width: 52rem) {
    .work {
      grid-template-columns: 1fr;
    }
    .more__row {
      grid-template-columns: 2.4rem minmax(0, 1fr) 1.5rem;
      row-gap: var(--space-1);
    }
    .more__tag,
    .more__desc {
      grid-column: 2;
    }
    .more :global(.more__arr) {
      grid-row: 1;
      grid-column: 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .more__row,
    .more__row::before {
      transition: none;
    }
  }
</style>
