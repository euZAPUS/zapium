---
import { PERSON, type Locale } from '~/config/site';
import { useT } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>
      © {year} {PERSON.name} · {t.footer.madeWith} · {t.footer.inspiredBy}
      <a href="https://alche.studio" target="_blank" rel="noopener noreferrer" data-cursor="link">
        alche.studio
      </a>
    </p>
    <p class="footer__legal">{t.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-6);
    border-top: var(--border-w) solid var(--line-soft);
    font-size: var(--text-s);
    color: var(--ink-muted);
  }
  .footer a {
    color: var(--ink);
    text-decoration: underline dotted;
    text-underline-offset: 0.25em;
    transition: color var(--dur-fast);
  }
  .footer a:hover {
    color: var(--accent);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }
</style>
