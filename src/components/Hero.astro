---
import { PERSON, type Locale } from '~/config/site';
import { useT } from '~/i18n';
import Icon from './Icon.astro';
import Mascot from './Mascot.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

// «Álvaro» / «Sánchez»: cada letra entra rebotando y salta al pasar el ratón
const words = PERSON.name.split(' ').map((w) => [...w]);
let n = 0;
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="hero__stick">
    <!-- Resplandor cálido estático detrás de la patata (el fondo vivo es el «mundo», ver World.astro) -->
    <div class="hero__bg" aria-hidden="true" data-hero-bg></div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow reveal" style="--delay:500ms">
          {t.hero.eyebrow}
        </p>
        <h1 id="hero-title" class="hero__title" aria-label={PERSON.name}>
          {words.map((letters) => (
            <span class="hero__word" aria-hidden="true">
              {letters.map((ch) => {
                const i = n++;
                return (
                  <span
                    class="ch"
                    style={`--i:${i};--r:${(i % 2 ? 1 : -1) * (6 + (i % 3) * 3)}deg`}
                  >
                    {ch}
                  </span>
                );
              })}
            </span>
          ))}
        </h1>
        <p class="hero__tagline reveal" style="--delay:1250ms">
          {t.hero.tagline}
        </p>
        <div class="hero__cta">
          <a
            class="btn btn--primary reveal"
            style="--delay:1400ms"
            href="#projects"
            data-cursor="link"
          >
            {t.hero.ctaProjects}
            <Icon name="arrow" />
          </a>
          <a
            class="btn reveal"
            style="--delay:1500ms"
            href="/assets/cv.pdf"
            aria-disabled="true"
            title={t.ui.cvSoon}
            data-cursor="link"
            data-cv
          >
            <Icon name="download" />
            {t.hero.ctaCv}
          </a>
          <a class="btn reveal" style="--delay:1600ms" href="#contact" data-cursor="link">
            <Icon name="mail" />
            {t.hero.ctaContact}
          </a>
        </div>
      </div>

      <div class="hero__stage" style="--intro:150ms">
        <Mascot alt={t.hero.mascotAlt} buttonLabel={t.hero.mascotButton} />
        <p class="hero__callout hero__callout--fig" aria-hidden="true">
          {t.hero.fig}
        </p>
        <p class="hero__callout hero__callout--scale" aria-hidden="true">
          {t.hero.scale}
        </p>
        <p
          class="hero__bubble"
          data-bubble
          data-jokes={JSON.stringify(t.hero.jokes)}
          aria-live="polite"
        >
          {t.hero.bubble}
        </p>
      </div>
    </div>

    <!-- La patata 3D y la «otra dimensión» (WebGL, potato/index.ts) se pintan aquí encima del texto -->
    <div class="hero__gl" data-hero-gl aria-hidden="true"></div>
    <p class="hero__dim" aria-hidden="true">
      <span>{t.hero.portal}</span>
      <i></i>
    </p>

    <a class="hero__scroll reveal" style="--delay:2300ms" href="#projects" data-cursor="link">
      <span>{t.hero.scroll}</span>
      <Icon name="arrow" class="hero__scroll-arrow" />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    /* Movimiento del cursor sobre el hero (lo escribe hero/interact.ts): -1 a 1 */
    --mx: 0;
    --my: 0;
    /* Con la patata 3D (data-gl) el hero se fija y el scroll recorre «travel» (potato/index.ts escribe --hp y --copy) */
    --travel: 230svh;
    --hp: 0;
    --copy: 1;
  }
  .hero__stick {
    position: relative;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + var(--space-6));
    padding-bottom: var(--space-9);
    display: grid;
    align-items: center;
  }
  :global(html.js) .hero[data-gl] {
    height: calc(100svh + var(--travel));
  }
  :global(html.js) .hero[data-gl] .hero__stick {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    padding-bottom: var(--space-7);
    overflow: clip;
  }
  .hero__gl {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .hero__gl :global(canvas) {
    display: block;
    max-width: none;
  }
  /* La patata 2D deja paso a la 3D (siguen en el DOM: botón de clic, texto alternativo y reserva sin WebGL) */
  .hero[data-gl] :global(.mascot__layer) {
    opacity: 0;
  }
  .hero[data-gl] .hero__copy,
  .hero[data-gl] .hero__bubble,
  .hero[data-gl] .hero__callout {
    opacity: var(--copy);
    translate: 0 calc((1 - var(--copy)) * -2.5rem);
  }
  .hero[data-gl][data-away] .hero__copy,
  .hero[data-gl][data-away] .hero__bubble,
  .hero[data-gl][data-away] .hero__callout {
    visibility: hidden;
  }
  .hero[data-gl] .hero__scroll {
    opacity: calc(1 - var(--hp) * 10);
  }
  /* Rótulo de la secuencia: aparece mientras se abre la otra dimensión */
  .hero__dim {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: var(--space-6);
    translate: -50% 0;
    display: none;
    width: min(22rem, calc(100% - 2 * var(--gutter)));
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink);
    opacity: var(--dim, 0);
    padding: var(--space-3) var(--space-4);
    background: var(--bg);
    border: var(--border-w) solid var(--line-soft);
  }
  .hero[data-gl] .hero__dim {
    display: block;
  }
  .hero__dim span::before {
    content: '';
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-inline-end: 0.7em;
    background: var(--accent);
  }
  .hero__dim i {
    display: block;
    height: 1px;
    margin-top: var(--space-2);
    background: var(--accent);
    transform-origin: 0 50%;
    scale: var(--hp) 1;
  }

  /* ── Fondo ───────────────────────────────────────────────────── */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    /* Fallback estático (sin WebGL / reduced-motion): un único resplandor naranja suave */
    background: radial-gradient(
      55% 50% at 76% 50%,
      color-mix(in srgb, var(--accent) 22%, transparent),
      transparent 70%
    );
  }
  /* ── Texto ───────────────────────────────────────────────────── */
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
  }
  /* El contenido no captura el puntero salvo lo interactivo */
  .hero__inner,
  .hero__copy,
  .hero__stage {
    pointer-events: none;
  }
  .hero__inner :is(a, button, .ch, .hero__bubble, .eyebrow, .hero__tagline) {
    pointer-events: auto;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    position: relative;
  }
  .hero__title {
    display: grid;
    font-size: var(--text-hero);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .hero__word {
    display: block;
    white-space: nowrap;
  }
  .ch {
    display: inline-block;
    cursor: default;
    transform-origin: 50% 85%;
    animation: letter-in 1.1s var(--ease-out) both;
    animation-delay: calc(700ms + var(--i) * 45ms);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ch:hover {
    color: var(--accent);
  }
  @keyframes letter-in {
    from {
      opacity: 0;
      translate: 0 38%;
      filter: blur(6px);
    }
    40% {
      opacity: 1;
    }
  }
  .reveal {
    animation: reveal 1s var(--ease-out) both;
    animation-delay: var(--delay, 0ms);
  }
  @keyframes reveal {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
    30% {
      opacity: 1;
    }
  }
  .hero__tagline {
    max-width: 34ch;
    font-size: var(--text-l);
    line-height: var(--leading-snug);
    color: var(--ink-muted);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* ── Escenario de la mascota ─────────────────────────────────── */
  .hero__stage {
    position: relative;
    justify-self: center;
    width: min(122%, 46rem);
    margin-inline-start: -4%;
  }
  .hero__stage :global(.mascot) {
    position: relative;
    z-index: 1;
  }
  .hero__bubble {
    position: absolute;
    z-index: 2;
    top: -22%;
    left: 22%;
    max-width: 15rem;
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    border: var(--border-w) solid var(--line-soft);
    border-radius: var(--radius-s);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    line-height: 1.5;
    animation: reveal 1s var(--ease-out) 1.7s both;
  }
  .hero__bubble.is-new {
    animation: bubble-pop 0.45s var(--ease-out);
  }
  @keyframes bubble-pop {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  .hero__callout {
    position: absolute;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .hero__callout::before {
    content: '';
    display: inline-block;
    width: 2.4rem;
    height: 0;
    margin-inline-end: 0.6rem;
    border-top: 1px solid var(--ink-muted);
    vertical-align: middle;
  }
  .hero__callout--fig {
    left: 26%;
    bottom: -13%;
  }
  .hero__callout--scale {
    right: 4%;
    top: 4%;
  }

  /* ── Pista de scroll ─────────────────────────────────────────── */
  .hero__scroll {
    position: absolute;
    bottom: var(--space-5);
    left: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-muted);
  }
  .hero__scroll :global(.hero__scroll-arrow) {
    width: 1.6rem;
    height: 1.6rem;
    rotate: 90deg;
    animation: nudge 1.4s var(--ease-in-out) infinite;
  }
  @keyframes nudge {
    50% {
      translate: 0.4rem 0;
    }
  }

  /* ── Móvil / tablet ──────────────────────────────────────────── */
  @media (max-width: 52rem) {
    .hero__stick {
      min-height: auto;
      padding-top: calc(var(--header-h) + var(--space-5));
      padding-bottom: var(--space-9);
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .hero__stage {
      order: -1;
      width: 100%;
      margin: 0;
      margin-top: var(--space-6);
    }
    .hero__bubble {
      top: -34%;
      left: 4%;
      max-width: 12rem;
    }
    .hero__callout {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch,
    .reveal,
    .hero__bubble,
    .hero__scroll :global(.hero__scroll-arrow) {
      animation: none !important;
    }
  }
</style>
