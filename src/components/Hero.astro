---
import { PERSON, type Locale } from '~/config/site';
import { useT } from '~/i18n';
import Icon from './Icon.astro';
import Doodle from './Doodle.astro';
import Mascot from './Mascot.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

// «Álvaro» / «Sánchez»: cada letra entra rebotando y salta al pasar el ratón
const words = PERSON.name.split(' ').map((w) => [...w]);
let n = 0;
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <!-- Fondo vivo: malla de color en WebGL (import dinámico). Sin WebGL o con reduced-motion queda el degradado CSS -->
  <div class="hero__bg" aria-hidden="true" data-hero-bg></div>
  <div class="hero__halftone" aria-hidden="true"></div>

  <div class="hero__doodles" aria-hidden="true">
    <Doodle name="bolt" style="top:15%;left:45%;--size:4.8rem" depth={0.9} rot={-12} delay={650} />
    <Doodle
      name="sparkle"
      style="top:11%;left:60%;--size:3rem"
      depth={1.3}
      color="var(--pink)"
      delay={820}
    />
    <Doodle
      name="bag"
      style="top:17%;left:86%;--size:4.4rem"
      depth={0.7}
      rot={10}
      color="var(--pink)"
      delay={980}
    />
    <Doodle
      name="sparkle"
      style="top:37%;left:95%;--size:2.5rem"
      depth={1.1}
      color="var(--sky)"
      delay={1120}
      hideOnMobile
    />
    <Doodle
      name="play"
      style="top:30%;left:64%;--size:4.6rem"
      depth={0.5}
      rot={-6}
      color="var(--accent-2)"
      delay={900}
    />
    <Doodle name="cube" style="top:68%;left:92%;--size:4.8rem" depth={0.8} rot={6} delay={1240} />
    <Doodle
      name="candles"
      style="top:79%;left:68%;--size:4.4rem"
      depth={0.6}
      rot={-8}
      delay={1060}
    />
    <Doodle
      name="coin"
      style="top:84%;left:80%;--size:3.8rem"
      depth={1}
      rot={14}
      delay={1300}
      hideOnMobile
    />
    <Doodle
      name="network"
      style="top:57%;left:52%;--size:4rem"
      depth={0.7}
      rot={-10}
      delay={1180}
      hideOnMobile
    />
    <Doodle
      name="terminal"
      style="top:80%;left:47%;--size:4.6rem"
      depth={0.4}
      rot={4}
      delay={1400}
      hideOnMobile
    />
    <Doodle
      name="code"
      style="top:70%;left:60%;--size:4.2rem"
      depth={0.5}
      rot={-5}
      color="var(--accent-2)"
      delay={1000}
      hideOnMobile
    />
    <Doodle
      name="chip"
      style="top:86%;left:94%;--size:3.4rem"
      depth={0.9}
      rot={-10}
      color="var(--sky)"
      delay={1500}
      hideOnMobile
    />
    <Doodle
      name="plus"
      style="top:14%;left:75%;--size:2.2rem"
      depth={1.2}
      color="var(--mint)"
      delay={760}
    />
    <Doodle
      name="ring"
      style="top:92%;left:62%;--size:2.6rem"
      depth={1.1}
      color="var(--sun)"
      delay={1340}
      hideOnMobile
    />
    <Doodle
      name="squiggle"
      style="top:26%;left:80%;--size:4rem"
      depth={0.8}
      rot={-4}
      color="var(--mint)"
      delay={1080}
      hideOnMobile
    />
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow reveal" style="--delay:500ms">
        {t.hero.eyebrow}
      </p>
      <h1 id="hero-title" class="hero__title" aria-label={PERSON.name}>
        {words.map((letters) => (
          <span class="hero__word" aria-hidden="true">
            {letters.map((ch) => {
              const i = n++;
              return (
                <span class="ch" style={`--i:${i};--r:${(i % 2 ? 1 : -1) * (6 + (i % 3) * 3)}deg`}>
                  {ch}
                </span>
              );
            })}
          </span>
        ))}
      </h1>
      <p class="hero__tagline reveal" style="--delay:1250ms">
        {t.hero.tagline}
      </p>
      <div class="hero__cta">
        <a
          class="btn btn--primary reveal"
          style="--delay:1400ms"
          href="#projects"
          data-cursor="link"
        >
          {t.hero.ctaProjects}
          <Icon name="arrow" />
        </a>
        <a
          class="btn reveal"
          style="--delay:1500ms"
          href="/assets/cv.pdf"
          aria-disabled="true"
          title={t.ui.cvSoon}
          data-cursor="link"
          data-cv
        >
          <Icon name="download" />
          {t.hero.ctaCv}
        </a>
        <a class="btn reveal" style="--delay:1600ms" href="#contact" data-cursor="link">
          <Icon name="mail" />
          {t.hero.ctaContact}
        </a>
      </div>
    </div>

    <div class="hero__stage" style="--intro:150ms">
      <Mascot alt={t.hero.mascotAlt} buttonLabel={t.hero.mascotButton} />
      <p
        class="hero__bubble"
        data-bubble
        data-jokes={JSON.stringify(t.hero.jokes)}
        aria-live="polite"
      >
        {t.hero.bubble}
      </p>
    </div>
  </div>

  <a class="hero__scroll reveal" style="--delay:2300ms" href="#projects" data-cursor="link">
    <span>{t.hero.scroll}</span>
    <Icon name="arrow" class="hero__scroll-arrow" />
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + var(--space-6));
    padding-bottom: var(--space-9);
    display: grid;
    align-items: center;
    isolation: isolate;
    overflow: clip;
    /* Movimiento del cursor sobre el hero (lo escribe hero/interact.ts): -1 a 1 */
    --mx: 0;
    --my: 0;
  }

  /* ── Fondo ───────────────────────────────────────────────────── */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    /* Fallback estático: manchas suaves de color (sin WebGL / reduced-motion) */
    background:
      radial-gradient(
        60% 55% at 78% 48%,
        color-mix(in srgb, var(--accent) 38%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40% 40% at 92% 12%,
        color-mix(in srgb, var(--pink) 34%, transparent),
        transparent 70%
      ),
      radial-gradient(
        45% 40% at 60% 95%,
        color-mix(in srgb, var(--sky) 30%, transparent),
        transparent 70%
      );
  }
  .hero__bg :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }
  .hero__bg[data-ready] :global(canvas) {
    opacity: 1;
  }
  .hero__halftone {
    position: absolute;
    inset: auto auto 0 0;
    z-index: -1;
    width: min(46rem, 70%);
    height: 22rem;
    pointer-events: none;
    opacity: 0.16;
    background: radial-gradient(var(--ink) 1.3px, transparent 1.8px) 0 0 / 14px 14px;
    mask-image: radial-gradient(80% 100% at 0% 100%, #000, transparent);
  }

  /* ── Doodles ─────────────────────────────────────────────────── */
  .hero__doodles {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero__doodles :global(.doodle) {
    position: absolute;
    width: var(--size, 4rem);
    aspect-ratio: 1;
    rotate: var(--rot, 0deg);
    translate: calc(var(--mx) * var(--depth) * -26px) calc(var(--my) * var(--depth) * -20px);
    transition: translate 0.5s var(--ease-out);
    animation: doodle-in 1.1s var(--ease-spring) both;
    animation-delay: var(--delay, 0ms);
    pointer-events: auto;
  }
  .hero__doodles :global(.doodle__in) {
    display: block;
    width: 100%;
    height: 100%;
    animation: float 5.5s var(--ease-in-out) infinite;
    animation-delay: calc(var(--delay, 0ms) * -1);
    filter: drop-shadow(0.18rem 0.22rem 0 rgb(23 19 14 / 0.9));
  }
  .hero__doodles :global(.doodle__in svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero__doodles :global(.doodle:hover .doodle__in) {
    animation: wiggle 0.6s var(--ease-pop);
  }
  @keyframes doodle-in {
    from {
      scale: 0;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
  }
  @keyframes float {
    50% {
      transform: translateY(-0.7rem) rotate(4deg);
    }
  }
  @keyframes wiggle {
    20% {
      transform: rotate(-16deg) scale(1.2);
    }
    50% {
      transform: rotate(12deg) scale(1.25);
    }
    80% {
      transform: rotate(-6deg) scale(1.1);
    }
  }

  /* ── Texto ───────────────────────────────────────────────────── */
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
  }
  /* El contenido deja pasar el puntero a los doodles; solo captura lo interactivo */
  .hero__inner,
  .hero__copy,
  .hero__stage {
    pointer-events: none;
  }
  .hero__inner :is(a, button, .ch, .hero__bubble, .eyebrow, .hero__tagline) {
    pointer-events: auto;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    position: relative;
  }
  .hero__title {
    display: grid;
    font-size: var(--text-hero);
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-shadow: 0.045em 0.055em 0 var(--accent);
  }
  .hero__word {
    display: block;
    white-space: nowrap;
  }
  .ch {
    display: inline-block;
    cursor: default;
    transform-origin: 50% 85%;
    animation: letter-in 1s var(--ease-spring) both;
    animation-delay: calc(700ms + var(--i) * 55ms);
  }
  .ch:hover {
    animation: hop 0.6s var(--ease-pop);
    color: var(--accent-2);
  }
  @keyframes letter-in {
    from {
      opacity: 0;
      translate: 0 80%;
      rotate: calc(var(--r) * -2);
      scale: 0.3;
    }
    25% {
      opacity: 1;
    }
  }
  @keyframes hop {
    35% {
      translate: 0 -16%;
      rotate: var(--r);
      scale: 1.12 1.18;
    }
    70% {
      translate: 0 2%;
      scale: 1.08 0.9;
    }
  }
  .reveal {
    animation: reveal 0.9s var(--ease-spring) both;
    animation-delay: var(--delay, 0ms);
  }
  @keyframes reveal {
    from {
      opacity: 0;
      translate: 0 1.6rem;
      scale: 0.92;
    }
    25% {
      opacity: 1;
    }
  }
  .hero__tagline {
    max-width: 34ch;
    font-size: var(--text-l);
    line-height: var(--leading-snug);
    color: var(--ink-muted);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* ── Escenario de la mascota ─────────────────────────────────── */
  .hero__stage {
    position: relative;
    justify-self: center;
    width: min(122%, 46rem);
    margin-inline-start: -4%;
  }
  .hero__stage :global(.mascot) {
    position: relative;
    z-index: 1;
  }
  .hero__bubble {
    position: absolute;
    z-index: 2;
    top: -22%;
    left: 22%;
    max-width: 15rem;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-m) var(--radius-m) var(--radius-m) 0.25rem;
    box-shadow: var(--shadow-hard);
    font-size: var(--text-s);
    font-weight: 600;
    line-height: 1.3;
    transform-origin: 10% 100%;
    animation: reveal 0.9s var(--ease-spring) 1.7s both;
  }
  .hero__bubble.is-new {
    animation: bubble-pop 0.55s var(--ease-pop);
  }
  @keyframes bubble-pop {
    from {
      scale: 0.7;
      rotate: -4deg;
    }
  }

  .hero__callout {
    position: absolute;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .hero__callout::before {
    content: '';
    display: inline-block;
    width: 2.4rem;
    height: 0;
    margin-inline-end: 0.6rem;
    border-top: 2px solid var(--ink);
    vertical-align: middle;
  }
  .hero__callout--fig {
    left: 30%;
    bottom: -7%;
  }
  .hero__callout--scale {
    right: 4%;
    top: 4%;
  }

  /* ── Pista de scroll ─────────────────────────────────────────── */
  .hero__scroll {
    position: absolute;
    bottom: var(--space-5);
    left: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-muted);
  }
  .hero__scroll :global(.hero__scroll-arrow) {
    width: 1.6rem;
    height: 1.6rem;
    rotate: 90deg;
    animation: nudge 1.4s var(--ease-in-out) infinite;
  }
  @keyframes nudge {
    50% {
      translate: 0.4rem 0;
    }
  }

  /* ── Móvil / tablet ──────────────────────────────────────────── */
  @media (max-width: 52rem) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--header-h) + var(--space-5));
      padding-bottom: var(--space-9);
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .hero__stage {
      order: -1;
      width: 100%;
      margin: 0;
      margin-top: var(--space-6);
    }
    .hero__bubble {
      top: -34%;
      left: 4%;
      max-width: 12rem;
    }
    .hero__callout {
      display: none;
    }
    .hero__doodles :global(.doodle--desktop) {
      display: none;
    }
    .hero__doodles :global(.doodle) {
      scale: 0.8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch,
    .reveal,
    .hero__bubble,
    .hero__doodles :global(.doodle),
    .hero__doodles :global(.doodle__in),
    .hero__scroll :global(.hero__scroll-arrow) {
      animation: none !important;
    }
  }
</style>
