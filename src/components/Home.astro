---
import type { Locale } from '~/config/site';
import Base from '~/layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Footer from './Footer.astro';
import Preloader from './Preloader.astro';
import Hud from './Hud.astro';
import World from './World.astro';
import Gizmo from './Gizmo.astro';
import ProjectScene from './ProjectScene.astro';
import AboutTrack from './AboutTrack.astro';
import AiSection from './AiSection.astro';
import StackSection from './StackSection.astro';
import ContactSection from './ContactSection.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale} intro>
  <World />
  <Gizmo />
  <Preloader locale={locale} />
  <Hud locale={locale} />
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <ProjectScene locale={locale} />
    <AboutTrack locale={locale} />
    <AiSection locale={locale} />
    <StackSection locale={locale} />
    <ContactSection locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
