---
import type { Locale } from '~/config/site';
import { useT } from '~/i18n';
import Base from '~/layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Footer from './Footer.astro';
import Preloader from './Preloader.astro';
import Hud from './Hud.astro';
import World from './World.astro';
import Gizmo from './Gizmo.astro';
import Works from './Works.astro';
import AboutTrack from './AboutTrack.astro';
import AiSection from './AiSection.astro';
import StackSection from './StackSection.astro';
import LabTeaser from './LabTeaser.astro';
import ContactSection from './ContactSection.astro';
import DemoDialog from './DemoDialog.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<Base locale={locale} intro>
  <World />
  <Gizmo />
  <Preloader locale={locale} />
  <Hud locale={locale} />
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <Works locale={locale} />
    <AboutTrack locale={locale} />
    <AiSection locale={locale} />
    <StackSection locale={locale} />
    <LabTeaser locale={locale} />
    <ContactSection locale={locale} />
  </main>
  <DemoDialog
    lang={locale}
    close={t.story.projects.demoClose}
    loading={t.story.projects.demoLoading}
    error={t.story.projects.demoError}
  />
  <Footer locale={locale} />
</Base>
