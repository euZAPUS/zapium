---
import { PERSON, type Locale } from '~/config/site';
import { useT } from '~/i18n';
import Icon from './Icon.astro';
import Guide from './Guide.astro';
import ProofVideo from './ProofVideo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = useT(locale).story.projects;
const repo = `${PERSON.github}/zapper-aio`;
const releases = `${PERSON.github}/zapper-aio-releases/releases/latest`;
---

<section class="scene" id="projects" aria-labelledby="projects-title" data-scene>
  <div class="scene__stick">
    <div class="scene__backdrop" aria-hidden="true">
      <ProofVideo backdrop label={s.videoTodo} />
    </div>

    <div class="container scene__grid">
      <div class="scene__copy card">
        <p class="tag">{s.tag}</p>
        <h2 id="projects-title" class="scene__title">
          {s.title}
        </h2>
        <p class="scene__summary">{s.summary}</p>
        <dl class="facts">
          {s.facts.map((f) => (
            <>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </>
          ))}
        </dl>
        <div class="scene__links">
          <a class="btn btn--primary" href={repo} data-cursor="link">
            <Icon name="branch" />
            {s.repo}
          </a>
          <a class="btn" href={releases} data-cursor="link">
            <Icon name="download" />
            {s.download}
          </a>
        </div>
      </div>

      <div class="scene__stage">
        <ProofVideo class="scene__proof" label={s.videoTodo} title="zapper-aio" />
        <Guide class="scene__guide" text={s.bubble} />
      </div>
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    overflow: clip; /* el fondo desenfocado sobresale: se recorta aquí (clip no rompe el sticky) */
    min-height: 240svh;
    --sp: 0; /* progreso de la escena, 0 → 1 (lo escribe scripts/story.ts) */
  }
  .scene__stick {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    align-items: center;
    overflow: clip;
    padding-top: var(--header-h);
  }
  .scene__backdrop {
    position: absolute;
    inset: -12%;
    z-index: -1;
    opacity: 0.7;
    transform: scale(1.12) translateY(calc(var(--sp) * -7%));
  }
  .scene__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-7);
    align-items: center;
  }
  .scene__copy {
    display: grid;
    gap: var(--space-4);
    opacity: calc(0.35 + var(--sp) * 8);
    translate: 0 calc((1 - min(1, var(--sp) * 8)) * 3rem);
  }
  .scene__title {
    font-size: var(--text-2xl);
    line-height: 0.95;
  }
  .scene__summary {
    color: var(--ink-muted);
    font-size: var(--text-m);
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-size: var(--text-s);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: 0.15rem;
  }
  .facts dd {
    margin: 0;
  }
  .scene__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* El vídeo «real» gira en 3D con el scroll mientras el de fondo se desenfoca detrás */
  .scene__stage {
    position: relative;
    perspective: 1400px;
    container-type: inline-size; /* para que la patata recorra justo el ancho del escenario */
  }
  .scene__stage :global(.scene__proof) {
    transform: rotateY(calc((var(--sp) - 0.5) * -30deg)) rotateX(calc((var(--sp) - 0.5) * 9deg));
    transform-style: preserve-3d;
  }

  /* La patata guía cruza el escenario girando, como un tutorial */
  .scene :global(.scene__guide) {
    position: absolute;
    left: 0;
    bottom: -14%;
    width: min(20rem, 36vw);
    translate: calc(var(--sp) * (100cqw - 100%)) calc(sin(var(--sp) * 12.566rad) * -1.2rem);
  }
  .scene :global(.scene__guide .guide__spin) {
    transform: perspective(800px) rotateY(calc(var(--sp) * 720deg));
  }
  .scene :global(.scene__guide .guide__bubble) {
    opacity: clamp(0, calc((var(--sp) - 0.08) * 10), 1);
  }

  @media (max-width: 52rem) {
    .scene {
      min-height: auto;
    }
    .scene__stick {
      position: relative;
      height: auto;
      padding-block: var(--space-8);
    }
    .scene__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .scene__copy {
      opacity: 1;
      translate: none;
    }
    .scene__stage :global(.scene__proof) {
      transform: none;
    }
    .scene :global(.scene__guide) {
      position: relative;
      translate: none;
      width: 11rem;
      margin: var(--space-5) auto 0;
    }
    .scene :global(.scene__guide .guide__spin) {
      transform: none;
    }
    .scene :global(.scene__guide .guide__bubble) {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene {
      min-height: auto;
    }
    .scene__stick {
      position: relative;
      height: auto;
      padding-block: var(--space-8);
    }
    .scene__copy {
      opacity: 1;
      translate: none;
    }
    .scene__stage :global(.scene__proof),
    .scene :global(.scene__guide .guide__spin) {
      transform: none;
    }
    .scene :global(.scene__guide) {
      translate: none;
    }
    .scene :global(.scene__guide .guide__bubble) {
      opacity: 1;
    }
  }
</style>
