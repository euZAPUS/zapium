---
/**
 * Iconos SVG propios, dibujados a mano para este proyecto (trazo irregular,
 * a juego con el dibujo de la patata). Grosor y color salen de los tokens
 * (--icon-stroke, currentColor): cambian solos con el tema y la paleta.
 */
const ICONS = {
  sun: '<circle cx="12" cy="12" r="4.1"/><path d="M12 2.8v2.2M12.1 19v2.3M2.9 12.1h2.2M19 11.9h2.2M5.6 5.7l1.5 1.6M16.9 16.8l1.6 1.5M18.4 5.5l-1.6 1.6M7.2 16.7l-1.6 1.7"/>',
  moon: '<path d="M20.2 14.4A8.4 8.4 0 0 1 9.6 3.8a8.4 8.4 0 1 0 10.6 10.6z"/>',
  menu: '<path d="M4 7.2c5-.5 11 .5 16 0M4 12.1c4-.4 8 .4 12 0M4 17c5 .5 11-.4 16 .1"/>',
  close: '<path d="M6 6.2c4 3.8 8 7.9 12 11.6M18 6c-4 4-8 8-12 12"/>',
  arrow: '<path d="M4 12.3c5 .3 10-.4 15 0M13.3 6.6c2.5 2 4.3 3.9 5.9 5.5-1.8 1.7-3.7 3.5-6 5.7"/>',
  download:
    '<path d="M12 4v10.8M7.2 10.6c1.8 1.6 3.3 3.2 4.8 4.6 1.600-1.400 3.200-3 4.900-4.600M5 19.800c4.600.4 9.400.4 14 0"/>',
  mail: '<path d="M4 6.5c5-.6 11-.5 16 0 .5 3.7.4 7.200 0 11-5 .6-11 .5-16 0-.5-3.800-.4-7.300 0-11zM4.500 7.600c3.200 3 4.800 4.500 7.500 4.700 2.700-.2 4.300-1.700 7.500-4.700"/>',
  'sound-on':
    '<path d="M4 9.6c0-.7.4-1 1-1h2.600L12 5v14l-4.400-3.600H5c-.6 0-1-.3-1-1z"/><path d="M15.500 9.200c1.300 1.600 1.300 4 0 5.600M18.200 6.800c2.500 3 2.500 7.400 0 10.400"/>',
  'sound-off':
    '<path d="M4 9.6c0-.7.4-1 1-1h2.600L12 5v14l-4.400-3.600H5c-.6 0-1-.3-1-1z"/><path d="M16 9.500l5 5M21 9.400l-5 5.200"/>',
  branch:
    '<circle cx="7" cy="5.2" r="2.1"/><circle cx="7" cy="18.8" r="2.1"/><circle cx="17" cy="7.4" r="2.1"/><path d="M7 7.3v9.400M17 9.500c0 4.500-9.800 1.500-10 5.200"/>',
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
