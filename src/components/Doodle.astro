---
/**
 * Doodles: dibujitos a juego con la patata (contorno negro grueso, colores de
 * pegatina) sobre el mundo del autor: rayo (zapper/zap), código, velas de trading,
 * bolsa (dropshipping), play (vídeo), terminal (shell de 42), cubo (huerto de
 * Zapper), moneda, red (ASIR), «C» (lenguaje C) y adornos. Obra propia: ver
 * LICENSE-CONTENT.md. Sin logos de marcas.
 *
 * Capas de movimiento (no se pisan: cada una usa una propiedad distinta):
 *   .doodle     → `translate` (parallax con el ratón) + `scale` (aparición con muelle)
 *   .doodle__in → `transform` (flotar en bucle y meneo al pasar el ratón)
 */
export type DoodleName =
  | 'bolt'
  | 'sparkle'
  | 'code'
  | 'candles'
  | 'bag'
  | 'play'
  | 'terminal'
  | 'cube'
  | 'coin'
  | 'network'
  | 'chip'
  | 'ring'
  | 'plus'
  | 'squiggle';

interface Props {
  name: DoodleName;
  /** Posición y tamaño (CSS), p. ej. "top:12%;left:48%;--size:5rem" */
  style?: string;
  /** Intensidad del parallax (0-1.5) */
  depth?: number;
  /** Retraso de aparición en ms */
  delay?: number;
  /** Rotación base en grados */
  rot?: number;
  /** (Sin efecto visual desde el giro «plano técnico»: la piel de línea fina ignora los colores.) */
  color?: string;
  /** Se oculta en pantallas pequeñas */
  hideOnMobile?: boolean;
}
const {
  name,
  style = '',
  depth = 0.6,
  delay = 0,
  rot = 0,
  color = 'var(--accent)',
  hideOnMobile = false,
} = Astro.props;

const O = 'stroke:var(--potato-line);stroke-width:4.5;stroke-linejoin:round;stroke-linecap:round';
const fill = (c: string) => `style="fill:${c};${O}"`;
const line = (c: string, w = 7) =>
  `<path style="fill:none;stroke:var(--potato-line);stroke-width:${w + 6};stroke-linecap:round;stroke-linejoin:round" d="DD"/><path style="fill:none;stroke:${c};stroke-width:${w};stroke-linecap:round;stroke-linejoin:round" d="DD"/>`;
const stroked = (c: string, d: string, w = 7) => line(c, w).replaceAll('DD', d);

const art: Record<DoodleName, string> = {
  bolt: `<path ${fill(color)} d="M38 4 12 37h17l-5 23 28-36H35z"/>`,
  sparkle: `<path ${fill(color)} d="M32 3c2 18 9 27 29 29-20 2-27 11-29 29-2-18-9-27-29-29C23 30 30 21 32 3z"/>`,
  code:
    stroked(color, 'M22 17 7 32l15 15') +
    stroked('var(--sun)', 'M42 17l15 15-15 15') +
    stroked('var(--surface)', 'M37 12 27 52', 6),
  candles:
    `<path style="fill:none;stroke:var(--potato-line);stroke-width:4.5;stroke-linecap:round" d="M16 8v46M43 4v38"/>` +
    `<rect ${fill('var(--mint)')} x="8" y="20" width="16" height="24" rx="3"/>` +
    `<rect ${fill('var(--accent-2)')} x="35" y="12" width="16" height="22" rx="3"/>`,
  bag:
    `<path style="fill:none;stroke:var(--potato-line);stroke-width:4.5;stroke-linecap:round" d="M22 24c0-18 20-18 20 0"/>` +
    `<path ${fill(color)} d="M10 23h44l-3 35H13z"/>` +
    `<path style="fill:none;stroke:var(--potato-line);stroke-width:4;stroke-linecap:round" d="M24 34c3 6 13 6 16 0"/>`,
  play:
    `<rect ${fill(color)} x="5" y="14" width="54" height="38" rx="12"/>` +
    `<path ${fill('var(--surface)')} d="M27 23l16 10-16 10z"/>`,
  terminal:
    `<rect ${fill('var(--surface)')} x="5" y="9" width="54" height="46" rx="8"/>` +
    `<path style="fill:none;stroke:var(--potato-line);stroke-width:4.5;stroke-linecap:round" d="M5 22h54"/>` +
    stroked('var(--mint)', 'm16 31 8 6-8 6', 5) +
    stroked('var(--accent)', 'M30 46h14', 5),
  cube:
    `<path ${fill('var(--sun)')} d="M32 14 56 26 32 38 8 26z"/>` +
    `<path ${fill('var(--accent)')} d="M8 26 32 38v22L8 48z"/>` +
    `<path ${fill('var(--accent-2)')} d="M56 26 32 38v22l24-12z"/>` +
    stroked('var(--mint)', 'M32 14c0-6 0-9-3-12M32 12c4-7 10-7 13-5', 4),
  coin:
    `<circle ${fill('var(--sun)')} cx="32" cy="32" r="25"/>` +
    `<circle style="fill:none;stroke:var(--potato-line);stroke-width:2.5;stroke-dasharray:2 5;stroke-linecap:round" cx="32" cy="32" r="18"/>` +
    `<path style="fill:none;stroke:var(--potato-line);stroke-width:4.5;stroke-linecap:round" d="M38 23c-3-4-12-3-12 3s12 4 12 11-9 8-13 3M32 15v34"/>`,
  network:
    `<path style="fill:none;stroke:var(--potato-line);stroke-width:4.5;stroke-linecap:round" d="M32 16 14 46h36z"/>` +
    `<circle ${fill('var(--sky)')} cx="32" cy="14" r="9"/>` +
    `<circle ${fill('var(--pink)')} cx="13" cy="47" r="9"/>` +
    `<circle ${fill('var(--mint)')} cx="51" cy="47" r="9"/>`,
  chip:
    `<rect ${fill(color)} x="8" y="8" width="48" height="48" rx="12"/>` +
    stroked('var(--surface)', 'M43 23C32 12 17 19 17 32s15 20 26 9', 7),
  ring: `<circle style="fill:none;stroke:var(--potato-line);stroke-width:16;" cx="32" cy="32" r="18"/><circle style="fill:none;stroke:${color};stroke-width:8" cx="32" cy="32" r="18"/>`,
  plus: stroked(color, 'M32 8v48M8 32h48', 9),
  squiggle: stroked(color, 'M5 38C13 18 21 54 32 33s19 17 27-5', 7),
};
---

<span
  class:list={['doodle', { 'doodle--desktop': hideOnMobile }]}
  style={`${style};--depth:${depth};--delay:${delay}ms;--rot:${rot}deg`}
  data-doodle
  aria-hidden="true"
>
  <span class="doodle__in">
    <svg viewBox="0 0 64 64" focusable="false" set:html={art[name]} />
  </span>
</span>

<style is:global>
  .doodle {
    display: inline-block;
    width: var(--size, 4rem);
    aspect-ratio: 1;
  }
  /* Piel «plano técnico»: trazo fino de una sola tinta en vez de pegatinas de colores. Los dibujos siguen
     siendo los mismos; el naranja de la patata aparece al pasar el cursor. */
  .doodle svg * {
    fill: none !important;
    stroke: var(--doodle-line, var(--ink-muted)) !important;
    stroke-width: 1.5px !important;
    stroke-dasharray: none !important;
    vector-effect: non-scaling-stroke;
    transition: stroke 0.25s;
  }
  .doodle:hover svg * {
    stroke: var(--accent) !important;
  }
  .doodle__in,
  .doodle__in svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
