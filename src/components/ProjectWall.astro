---
/**
 * «La pared»: los proyectos como una rejilla de dos filas que se desliza de lado con el
 * scroll, en 3D y con las tarjetas flotando. Escritorio: la sección se fija y el scroll
 * vertical recorre la pared (scripts/wall.ts escribe --hp, --ep y, en cada tarjeta, --d =
 * distancia al centro de la pantalla; con eso las tarjetas se curvan como un coverflow).
 * Móvil: el mismo grid, pero con deslizamiento nativo (scroll-snap) y la misma inclinación.
 * prefers-reduced-motion: rejilla normal, sin fijado ni movimiento.
 * El proyecto destacado (Zapper AIO) ocupa 3×2 celdas y lleva el vídeo «real» delante del
 * mismo vídeo desenfocado de fondo.
 */
import { PERSON, type Locale } from '~/config/site';
import { labPath, useT } from '~/i18n';
import Doodle, { type DoodleName } from './Doodle.astro';
import Icon from './Icon.astro';
import Guide from './Guide.astro';
import ProofVideo from './ProofVideo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = useT(locale).story.projects;
const repo = `${PERSON.github}/zapper-aio`;
const releases = `${PERSON.github}/zapper-aio-releases/releases/latest`;
const lab = labPath(locale);

const meta: Record<string, { href: string; doodle: DoodleName; color: string }> = {
  libft: { href: `${PERSON.github}/Campus42`, doodle: 'terminal', color: 'var(--mint)' },
  zapium: { href: `${PERSON.github}/zapium`, doodle: 'sparkle', color: 'var(--pink)' },
  subnet: { href: `${lab}#subnet`, doodle: 'network', color: 'var(--sky)' },
  bits: { href: `${lab}#bits`, doodle: 'chip', color: 'var(--accent)' },
  risk: { href: `${lab}#risk`, doodle: 'candles', color: 'var(--mint)' },
  dropshipping: { href: '#about', doodle: 'bag', color: 'var(--pink)' },
  trading: { href: '#about', doodle: 'coin', color: 'var(--sun)' },
  github: { href: PERSON.github, doodle: 'bolt', color: 'var(--accent)' },
};
---

<section class="wall" id="projects" aria-labelledby="projects-title" data-wall>
  <div class="wall__stick">
    <div class="wall__backdrop" aria-hidden="true">
      <ProofVideo backdrop label={s.videoTodo} />
    </div>

    <div class="wall__ambient" aria-hidden="true">
      <span class="amb" style="--x:47%;--y:3%;--par:260;--s:3.6rem">
        <Doodle name="plus" style="--size:var(--s)" color="var(--sky)" depth={0} rot={12} />
      </span>
      <span class="amb" style="--x:36%;--y:88%;--par:520;--s:3.4rem">
        <Doodle name="sparkle" style="--size:var(--s)" color="var(--sun)" depth={0} rot={-8} />
      </span>
      <span class="amb" style="--x:62%;--y:10%;--par:380;--s:5rem">
        <Doodle name="ring" style="--size:var(--s)" color="var(--pink)" depth={0} rot={20} />
      </span>
      <span class="amb" style="--x:90%;--y:84%;--par:700;--s:4rem">
        <Doodle name="squiggle" style="--size:var(--s)" color="var(--mint)" depth={0} rot={-14} />
      </span>
    </div>

    <header class="container wall__head">
      <div>
        <p class="tag">{s.eyebrow}</p>
        <h2 id="projects-title" class="wall__title">
          {s.wallTitle}
        </h2>
      </div>
      <p class="wall__hint" aria-hidden="true">
        <span class="wall__hint-scroll">{s.wallHint}</span>
        <span class="wall__hint-swipe">{s.swipeHint}</span>
      </p>
    </header>

    <div class="wall__stage" data-wall-stage role="region" aria-label={s.wallLabel}>
      <div class="wall__rail" data-wall-rail>
        <div class="pcard pcard--hero" data-wall-card style="--i:0;--row:0">
          <div class="pcard__float">
            <div class="pcard__face card">
              <div class="hero__copy">
                <p class="tag">{s.tag}</p>
                <h3 class="hero__title">{s.title}</h3>
                <p class="hero__summary">{s.summary}</p>
                <dl class="facts">
                  {s.facts.map((f) => (
                    <>
                      <dt>{f.k}</dt>
                      <dd>{f.v}</dd>
                    </>
                  ))}
                </dl>
                <div class="hero__links">
                  <a class="btn btn--primary btn--small" href={repo} data-cursor="link">
                    <Icon name="branch" />
                    {s.repo}
                  </a>
                  <a class="btn btn--small" href={releases} data-cursor="link">
                    <Icon name="download" />
                    {s.download}
                  </a>
                </div>
              </div>
              <div class="hero__stage">
                <ProofVideo class="hero__proof" label={s.videoTodo} title="zapper-aio" />
              </div>
            </div>
          </div>
        </div>

        <ul class="wall__cards" data-wall-cards>
          {s.items.map((it, n) => {
            const m = meta[it.id] ?? meta.github!;
            return (
              <li class="pcard" data-wall-card style={`--i:${n + 1};--row:${n % 2}`}>
                <div class="pcard__float">
                  <div class="pcard__face card">
                    <Doodle
                      name={m.doodle}
                      style="--size:var(--doodle)"
                      color={m.color}
                      depth={0}
                    />
                    <p class="tag">{it.tag}</p>
                    <h3 class="pcard__title">{it.title}</h3>
                    <p class="pcard__body">{it.body}</p>
                    <a class="pcard__cta" href={m.href} data-cursor="link">
                      {it.cta}
                      <Icon name="arrow" />
                    </a>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </div>

    <Guide class="guide--wall" text={s.wallBubble} />
    <div class="wall__progress" aria-hidden="true">
      <i></i>
    </div>
  </div>
</section>

<style>
  .wall {
    position: relative;
    overflow: clip; /* el fondo desenfocado sobresale: se recorta aquí (clip no rompe el sticky) */
    padding-block: var(--space-8);
    --hp: 0; /* progreso horizontal 0 → 1 (scripts/wall.ts) */
    --ep: 1; /* entrada: 0 = la sección asoma por abajo, 1 = ya está fijada */
    --travel: 0px; /* cuánto avanza la pared, en px (scripts/wall.ts) */
    --wgap: var(--space-5);
    --cell-w: min(72vw, 18rem);
    --doodle: 3.2rem;
  }
  .wall__stick {
    position: relative;
  }
  .wall__backdrop {
    position: absolute;
    inset: -12%;
    z-index: -1;
    opacity: 0.7;
    transform: scale(1.12);
  }
  .wall__ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .amb {
    position: absolute;
    left: var(--x);
    top: var(--y);
    opacity: 0.9;
  }
  .wall__head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-5);
  }
  .wall__head > div {
    display: grid;
    gap: var(--space-2);
  }
  .wall__title {
    font-size: var(--text-xl);
    line-height: 0.98;
  }
  .wall__hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .wall__hint-scroll {
    display: none;
  }

  /* ── La pared. Móvil (por defecto): el destacado va apilado y las tarjetas forman un
     carril de dos filas con deslizamiento nativo (scroll-snap) ── */
  .wall__stage {
    position: relative;
    z-index: 1;
    padding-block: var(--space-4) var(--space-6);
  }
  .wall__rail {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }
  .wall__rail > .pcard--hero {
    width: min(100% - 2 * var(--gutter), 42rem);
    margin-inline: auto;
  }
  .wall__cards {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--cell-w);
    grid-template-rows: repeat(2, auto);
    gap: var(--wgap);
    margin: 0;
    padding: var(--space-3) var(--gutter) var(--space-4);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .wall__cards::-webkit-scrollbar {
    display: none;
  }
  .pcard {
    --rot: -22deg;
    --depth: -140px;
    position: relative;
    display: grid;
    scroll-snap-align: center;
    transform: perspective(900px)
      translateZ(calc(max(var(--d, 0), var(--d, 0) * -1) * var(--depth)))
      rotateY(calc(var(--d, 0) * var(--rot)));
  }
  .pcard--hero {
    transform: none;
  }

  .pcard__float {
    display: grid;
    animation: bob calc(5.5s + var(--i) * 0.45s) ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -1.3s);
  }
  .pcard:nth-child(even) .pcard__float {
    animation-direction: alternate-reverse;
  }
  .pcard--hero .pcard__float {
    animation-name: bob-soft; /* la tarjeta grande oscila menos: 0,6° en 70 rem se nota mucho */
  }
  @keyframes bob {
    from {
      translate: 0 -0.35rem;
      rotate: -0.5deg;
    }
    to {
      translate: 0 0.5rem;
      rotate: 0.6deg;
    }
  }

  @keyframes bob-soft {
    from {
      translate: 0 -0.25rem;
    }
    to {
      translate: 0 0.3rem;
      rotate: 0.12deg;
    }
  }

  .pcard__face {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    overflow: hidden;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  /* Brillo que sigue al puntero */
  .pcard__face::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      18rem circle at var(--gx, 50%) var(--gy, 0%),
      rgb(255 255 255 / 0.22),
      transparent 60%
    );
    opacity: var(--glare, 0);
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .pcard__title {
    font-size: var(--text-l);
    line-height: 1.05;
  }
  .pcard__body {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-s);
  }
  .pcard__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }
  .pcard__cta :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    transition: translate 0.25s var(--ease-pop);
  }
  /* Toda la tarjeta es clicable; el único enlace «real» es el CTA */
  .pcard:not(.pcard--hero) .pcard__cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pcard:not(.pcard--hero) .pcard__face:hover .pcard__cta :global(svg) {
    translate: 0.3rem 0;
  }
  .pcard__face:hover,
  .pcard__face:focus-within {
    box-shadow: var(--shadow-hard-lg);
  }

  /* ── Destacado: Zapper AIO ── */
  .pcard--hero .pcard__face {
    gap: var(--space-5);
  }
  .hero__copy {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }
  .hero__title {
    font-size: var(--text-xl);
    line-height: 0.95;
  }
  .hero__summary {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-s);
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-size: var(--text-xs);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: 0.1rem;
  }
  .facts dd {
    margin: 0;
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .hero__stage {
    align-self: center;
    perspective: 1200px;
  }
  .hero__stage :global(.hero__proof) {
    transform: rotateY(-7deg) rotateX(3deg);
    box-shadow: var(--shadow-hard);
  }

  .wall__ambient,
  .wall :global(.guide--wall),
  .wall__progress {
    display: none;
  }
  .wall__hint-swipe {
    display: inline;
  }

  /* ── Escritorio con JS: la sección se fija y el scroll recorre la pared en 3D ── */
  @media (min-width: 60rem) and (min-height: 38rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .wall {
      height: calc(100svh + var(--travel) * 1.25);
      padding-block: 0;
      --cell-w: clamp(15rem, 24vw, 22rem);
      --wall-h: clamp(24rem, calc(100svh - 17rem), 44rem);
      --doodle: clamp(2.4rem, 7svh, 3.6rem);
    }
    :global(html.js) .wall__stick {
      position: sticky;
      top: 0;
      height: 100svh;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      overflow: clip;
      padding-top: var(--header-h);
    }
    :global(html.js) .wall__head {
      margin-bottom: 0;
      padding-top: var(--space-4);
      padding-inline-start: max(var(--gutter), 5.5rem);
    }
    :global(html.js) .wall__hint-scroll {
      display: inline;
    }
    :global(html.js) .wall__hint-swipe {
      display: none;
    }
    :global(html.js) .wall__stage {
      overflow: clip;
      overflow-clip-margin: 2rem; /* sombra dura y vaivén de las tarjetas sobresalen de la celda */
      align-self: center;
      padding-block: 0;
      scroll-snap-type: none;
      perspective: 1400px;
      perspective-origin: calc(50% + var(--mx, 0) * 7%) calc(50% + var(--my, 0) * 9%);
      transition: perspective-origin 0.9s var(--ease-out);
    }
    :global(html.js) .wall__rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: var(--cell-w);
      grid-template-columns: none;
      grid-template-rows: repeat(2, calc((var(--wall-h) - var(--wgap)) / 2));
      gap: var(--wgap);
      width: max-content;
      transform-style: preserve-3d;
      padding-inline: max(var(--gutter), 5.5rem) var(--gutter);
      translate: calc(var(--hp) * var(--travel) * -1) 0;
      will-change: translate;
    }
    :global(html.js) .pcard {
      --rot: -26deg;
      --depth: -280px;
      scroll-snap-align: none;
      /* Entrada: llegan desde abajo y desde el fondo; después se curvan según su distancia al centro */
      transform: none;
      translate: 0 calc((1 - var(--ep)) * (24svh + var(--row, 0) * 8svh))
        calc(max(var(--d, 0), var(--d, 0) * -1) * var(--depth) + (1 - var(--ep)) * -520px);
      rotate: y calc(var(--d, 0) * var(--rot));
      scale: calc(1 - max(var(--d, 0), var(--d, 0) * -1) * 0.06);
      opacity: max(0.45, calc(0.15 + var(--ep) * 0.85 - max(var(--d, 0), var(--d, 0) * -1) * 0.3));
    }
    :global(html.js) .wall__cards {
      display: contents; /* las tarjetas pasan a ser celdas de la rejilla de la pared */
    }
    :global(html.js) .wall__rail > .pcard--hero {
      width: auto;
      margin-inline: 0;
      grid-column: span 3;
      grid-row: span 2;
    }
    :global(html.js) .pcard__float {
      min-height: 0; /* que la tarjeta no crezca más que su celda: si falta sitio, se recorta dentro */
    }
    :global(html.js) .pcard__face {
      min-height: 0;
      overflow: hidden;
    }
    :global(html.js) .pcard:not(.pcard--hero) .pcard__face {
      padding: var(--space-4) var(--space-5);
      gap: var(--space-2);
    }
    :global(html.js) .pcard__body {
      display: -webkit-box;
      -webkit-line-clamp: 4;
      line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    :global(html.js) .pcard--hero .pcard__face {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      padding: var(--space-5) var(--space-6);
    }
    :global(html.js) .wall__ambient {
      display: block;
    }
    @media (max-height: 52rem) {
      :global(html.js) .wall {
        --doodle: 2.6rem;
      }
      /* El doodle pasa a la esquina para ahorrar una fila de alto */
      :global(html.js) .pcard__face > :global(.doodle) {
        position: absolute;
        top: var(--space-3);
        right: var(--space-4);
      }
      :global(html.js) .pcard:not(.pcard--hero) .pcard__face {
        padding: var(--space-3) var(--space-4);
        gap: var(--space-1);
      }
      :global(html.js) .pcard:not(.pcard--hero) .pcard__title {
        font-size: var(--text-m);
      }
      :global(html.js) .pcard__body {
        -webkit-line-clamp: 3;
        line-clamp: 3;
      }
      :global(html.js) .facts dt:first-of-type,
      :global(html.js) .facts dd:first-of-type {
        display: none; /* «Problema»: ya lo cuenta el resumen */
      }
    }
    :global(html.js) .amb {
      translate: calc(var(--hp) * var(--par) * -1px) 0;
    }
    :global(html.js) .wall :global(.guide--wall) {
      display: block;
      position: absolute;
      z-index: 3;
      left: 14rem; /* deja libre el texto «User Perspective» del gizmo */
      bottom: 0.9rem;
      width: 7rem;
      translate: calc(var(--hp) * (100vw - 100% - 16rem)) calc(sin(var(--hp) * 18.85rad) * -0.5rem);
    }
    :global(html.js) .wall :global(.guide--wall .guide__spin) {
      transform: perspective(700px) rotateY(calc(var(--hp) * 1080deg));
    }
    :global(html.js) .wall :global(.guide--wall .guide__bubble) {
      bottom: 90%;
      opacity: min(
        clamp(0, calc((var(--hp) - 0.02) * 20), 1),
        clamp(0, calc((0.22 - var(--hp)) * 20), 1)
      );
    }
    :global(html.js) .wall__progress {
      display: block;
      position: absolute;
      z-index: 3;
      left: var(--gutter);
      right: var(--gutter);
      bottom: 0.6rem;
      height: 4px;
      background: var(--line-soft);
      border-radius: 4px;
    }
    :global(html.js) .wall__progress i {
      display: block;
      height: 100%;
      width: 100%;
      background: var(--accent);
      border-radius: 4px;
      transform-origin: 0 50%;
      scale: var(--hp) 1;
    }
  }

  /* Móvil / ventana baja: el destacado apila vídeo y texto */
  @media (max-width: 59.99rem) {
    .pcard--hero .pcard__face {
      grid-template-columns: 1fr;
    }
    .hero__stage {
      order: -1;
    }
  }

  /* Movimiento reducido: rejilla normal, sin fijado ni 3D */
  @media (prefers-reduced-motion: reduce) {
    .wall__rail > .pcard--hero {
      width: min(100% - 2 * var(--gutter), var(--container));
    }
    .wall__cards {
      width: min(100% - 2 * var(--gutter), var(--container));
      margin-inline: auto;
      padding-inline: 0;
      overflow: visible;
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-rows: none;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }
    .pcard {
      transform: none;
    }
    .pcard--hero .pcard__face {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .pcard__float {
      animation: none;
    }
    .pcard__face::before {
      display: none;
    }
    .hero__stage :global(.hero__proof) {
      transform: none;
    }
    .wall__hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) and (max-width: 47.99rem) {
    .pcard--hero .pcard__face {
      grid-template-columns: 1fr;
    }
  }
</style>
