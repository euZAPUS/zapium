---
/**
 * Carga a modo de plano: líneas finas que se dibujan formando la patata (guías,
 * cotas, círculos), un texto que se «descifra» y una persiana que revela el hero.
 * Idea tomada de referencias de estudios creativos; dibujo y textos propios.
 *
 * Solo se muestra en escritorio (puntero fino, ≥ 52rem), sin reduced-motion y en
 * la primera visita de la sesión: lo decide el script inline de Base.astro, que
 * pone `html.is-loading` antes del primer pintado. En móvil no aparece, así que no
 * retrasa el LCP.
 */
import type { Locale } from '~/config/site';
import { useT } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

// Contorno de la patata (coordenadas del dibujo original) solo para el trazo de plano
const BODY =
  'M745 412C770 401.5 814.2 395.3 850 392C885.8 388.7 925 389.3 960 392C995 394.7 1025.8 400 1060 408C1094.2 416 1137.5 428.8 1165 440C1192.5 451.2 1208.8 458.3 1225 475C1241.2 491.7 1252 514.2 1262 540C1272 565.8 1281.7 600 1285 630C1288.3 660 1287.5 693.3 1282 720C1276.5 746.7 1267.3 770.3 1252 790C1236.7 809.7 1222 823.7 1190 838C1158 852.3 1103.3 870.3 1060 876C1016.7 881.7 973.3 878.3 930 872C886.7 865.7 838.3 851.7 800 838C761.7 824.3 725.3 801.3 700 790C674.7 778.7 661 786.7 648 770C635 753.3 626.3 716.7 622 690C617.7 663.3 617.7 635.8 622 610C626.3 584.2 635 560.8 648 535C661 509.2 683.8 475.5 700 455C716.2 434.5 720 422.5 745 412Z';
const ARM_L =
  'M598 612C587.5 608.7 553 599.7 535 592C517 584.3 505 567 490 566C475 565 460 583 445 586C430 589 415.8 579 400 584C384.2 589 366.7 608 350 616C333.3 624 318.3 629 300 632C281.7 635 258.3 634.3 240 634C221.7 633.7 210.3 625.3 190 630C169.7 634.7 130 656.7 118 662';
const ARM_R =
  'M1312 674C1321.3 676.7 1350 690.3 1368 690C1386 689.7 1403 671.7 1420 672C1437 672.3 1454.2 688.3 1470 692C1485.8 695.7 1500.8 692.7 1515 694C1529.2 695.3 1543.3 695.3 1555 700C1566.7 704.7 1580 718.3 1585 722';

// Cruces `+` de la cuadrícula
const crosses = [] as { x: number; y: number }[];
for (let x = 120; x <= 1320; x += 240) for (const y of [90, 300, 600, 810]) crosses.push({ x, y });
---

<div
  class="pre"
  data-preloader
  role="dialog"
  aria-modal="true"
  aria-label={t.preloader.loading}
  data-state="prompt"
>
  <svg
    class="pre__svg"
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    focusable="false"
  >
    <g class="pre__grid">
      {crosses.map((c, i) => (
        <path
          class="fade"
          style={`--d:${1.1 + (i % 7) * 0.07}s`}
          d={`M${c.x - 7} ${c.y}h14M${c.x} ${c.y - 7}v14`}
        />
      ))}
    </g>
    <g transform="translate(0 -70)">
      <!-- Guías -->
      <g class="pre__lines">
        <path class="draw" style="--d:0.15s" pathLength="1" d="M388 0V900" />
        <path class="draw" style="--d:0.25s" pathLength="1" d="M1052 900V0" />
        <path class="draw" style="--d:0.4s" pathLength="1" d="M160 175H1280" />
        <path class="draw" style="--d:0.5s" pathLength="1" d="M1280 330H160" />
        <path class="draw" style="--d:0.6s" pathLength="1" d="M160 585H1280" />
        <path class="draw" style="--d:0.7s" pathLength="1" d="M1280 680H160" />
        <circle class="draw faint" style="--d:0.6s" pathLength="1" cx="720" cy="450" r="330" />
        <circle class="draw faint" style="--d:0.8s" pathLength="1" cx="720" cy="450" r="215" />
        <path
          class="draw faint"
          style="--d:0.9s"
          pathLength="1"
          d="M200 140 1240 760M1240 140 200 760"
        />
      </g>
      <!-- La patata, a trazo fino (cuerpo doble, brazos, ojos y boca) -->
      <g class="pre__potato" transform="translate(-141 -121) scale(.9)">
        <path class="draw" style="--d:0.9s;--t:1.7s" pathLength="1" d={BODY} />
        <path
          class="draw soft"
          style="--d:1.1s;--t:1.7s"
          pathLength="1"
          d={BODY}
          transform="translate(14 9)"
        />
        <path class="draw" style="--d:1.9s;--t:0.8s" pathLength="1" d={ARM_L} />
        <path class="draw" style="--d:2s;--t:0.8s" pathLength="1" d={ARM_R} />
        <circle class="draw" style="--d:2.3s;--t:0.5s" pathLength="1" cx="799" cy="579" r="20" />
        <circle class="draw" style="--d:2.4s;--t:0.5s" pathLength="1" cx="1126" cy="637" r="21" />
        <path
          class="draw"
          style="--d:2.5s;--t:0.5s"
          pathLength="1"
          d="M865 586C920 598 975 611 1030 627"
        />
      </g>
      <!-- Cotas y marcas en naranja -->
      <g class="pre__accent">
        <path
          class="draw"
          style="--d:1.3s;--t:1s"
          pathLength="1"
          d="M388 745H1052M388 735v20M1052 735v20"
        />
        <path
          class="draw"
          style="--d:1.5s;--t:1s"
          pathLength="1"
          d="M1100 220V700M1090 220h20M1090 700h20"
        />
        <rect class="fade" style="--d:0.4s" x="150" y="165" width="20" height="20" />
        <rect class="fade" style="--d:0.5s" x="1270" y="670" width="20" height="20" />
      </g>
      <g class="pre__labels">
        <text class="fade" style="--d:2s" x="720" y="772" text-anchor="middle">
          746 px
        </text>
        <text
          class="fade"
          style="--d:2.1s"
          x="1118"
          y="462"
          transform="rotate(90 1118 462)"
          text-anchor="middle"
        >
          480 px
        </text>
        <text class="fade" style="--d:1.2s" x="160" y="160">
          {t.preloader.scale}
        </text>
        <text class="fade" style="--d:1.3s" x="1280" y="705" text-anchor="end">
          {t.preloader.fig}
        </text>
      </g>
    </g>
  </svg>

  <div class="pre__text">
    <p class="pre__count">
      <span data-pre-count>000</span>
      <span class="pre__pct">%</span>
    </p>
    <p class="pre__line pre__line--1" data-pre-line1 data-text={t.preloader.line1}></p>
    <p class="pre__line pre__line--2" data-pre-line2 data-text={t.preloader.line2}></p>
  </div>

  <!-- 1.º: aviso de sonido (la elección se recuerda) -->
  <div class="pre__prompt" data-pre-prompt>
    <p class="pre__prompt-title">{t.preloader.soundTitle}</p>
    <p class="pre__prompt-text">{t.preloader.soundText}</p>
    <div class="pre__prompt-actions">
      <button class="pre__btn pre__btn--primary" type="button" data-pre-sound="on">
        {t.preloader.soundOn}
      </button>
      <button class="pre__btn" type="button" data-pre-sound="off">
        {t.preloader.soundOff}
      </button>
    </div>
  </div>

  <!-- 2.º: la carga avanza con el scroll -->
  <p class="pre__hint" data-pre-hint>
    <span class="pre__mouse" aria-hidden="true">
      <i></i>
    </span>
    {t.preloader.hint}
  </p>
  <button class="pre__skip" type="button" data-pre-skip aria-label={t.preloader.skipLabel}>
    {t.preloader.skip}
  </button>

  <div class="pre__panels">
    {Array.from({ length: 6 }, (_, i) => (
      <span class="pre__panel" style={`--i:${i}`}></span>
    ))}
  </div>
</div>

<style>
  .pre {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-preloader);
    color: #eeeeef;
    font-family: var(--font-mono);
    background: transparent;
  }
  :global(html.is-loading) .pre {
    display: block;
  }
  :global(html.is-loading) {
    overflow: hidden;
    overscroll-behavior: none;
  }
  .pre {
    touch-action: none; /* el gesto vertical avanza la carga, no desplaza la página */
  }

  /* Persiana: 6 paneles que cubren la pantalla y se retiran al terminar */
  .pre__panels {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  .pre__panel {
    background: #09090a;
    transition: translate 0.95s var(--ease-in-out);
    transition-delay: calc(var(--i) * 70ms);
    outline: 1px solid #09090a; /* tapa la rendija entre paneles */
  }
  .pre.is-done .pre__panel {
    translate: 0 -101%;
  }
  .pre.is-done .pre__svg,
  .pre.is-done .pre__text,
  .pre.is-done .pre__hint,
  .pre.is-done .pre__skip {
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .pre__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    fill: none;
    stroke: #eeeeef;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pre__accent {
    stroke: var(--potato);
    stroke-width: 2;
  }
  .pre__accent rect {
    fill: var(--potato);
    stroke: none;
  }
  .pre__grid {
    stroke-width: 1;
    opacity: 0.45;
  }
  .pre__labels text {
    fill: #eeeeef;
    stroke: none;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  /* El dibujo lo gobierna el progreso del scroll (preloader.ts): estado inicial = sin dibujar */
  .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .faint {
    opacity: 0.35;
  }
  .soft {
    opacity: 0.55;
  }
  .fade {
    opacity: 0;
  }

  .pre__text {
    position: absolute;
    left: 50%;
    bottom: 6%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    width: min(92vw, 44rem);
    text-align: center;
  }
  .pre__count {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--potato);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .pre__pct {
    font-size: 0.45em;
    margin-inline-start: 0.2em;
    color: #eeeeef;
  }
  .pre__line {
    margin: 0;
    min-height: 1.2em;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: pre;
  }
  .pre__line--2 {
    color: #8d8f96;
    letter-spacing: 0.08em;
    text-transform: none;
    font-size: var(--text-s);
  }
  .pre__prompt {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--gutter);
    text-align: center;
    background: rgb(20 17 13 / 0.78);
    backdrop-filter: blur(6px);
    transition: opacity 0.5s var(--ease-out);
  }
  .pre[data-state='scroll'] .pre__prompt,
  .pre.is-done .pre__prompt {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }
  .pre__prompt-title {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
    color: var(--potato);
  }
  .pre__prompt-text {
    margin: 0;
    max-width: 30rem;
    font-family: var(--font-body);
    font-size: var(--text-m);
    line-height: var(--leading-snug);
    color: #eeeeef;
  }
  .pre__prompt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-2);
  }
  .pre__btn {
    min-height: 2.75rem;
    padding: 0.5rem var(--space-5);
    border: 1px solid #eeeeef;
    border-radius: var(--radius-pill);
    background: transparent;
    color: #eeeeef;
    font-family: var(--font-mono);
    font-size: var(--text-s);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .pre__btn:hover {
    background: #eeeeef;
    color: #09090a;
    transform: translateY(-2px);
  }
  .pre__btn--primary {
    background: var(--potato);
    border-color: var(--potato);
    color: #09090a;
  }
  .pre__btn--primary:hover {
    background: #ffc94d;
    border-color: #ffc94d;
  }
  .pre__btn:focus-visible,
  .pre__skip:focus-visible {
    outline: 3px solid #ffc94d;
    outline-offset: 3px;
  }

  /* Pista: scroll para cargar */
  .pre__hint {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #eeeeef;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .pre[data-state='scroll'] .pre__hint {
    opacity: 1;
  }
  .pre[data-state='scroll'][data-engaged] .pre__hint {
    opacity: 0.45;
  }
  .pre__mouse {
    position: relative;
    width: 1.1rem;
    height: 1.7rem;
    border: 1px solid #eeeeef;
    border-radius: 0.6rem;
  }
  .pre__mouse i {
    position: absolute;
    top: 0.3rem;
    left: 50%;
    width: 2px;
    height: 0.4rem;
    margin-left: -1px;
    background: var(--potato);
    animation: wheel 1.4s var(--ease-in-out) infinite;
  }
  @keyframes wheel {
    0% {
      opacity: 0;
      translate: 0 -2px;
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: 0 0.55rem;
    }
  }
  .pre__skip {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-4);
    padding: 0.35rem 0.7rem;
    border: 1px solid #4a4c52;
    border-radius: var(--radius-pill);
    background: transparent;
    color: #8d8f96;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .pre__skip:hover {
    color: #eeeeef;
    border-color: #eeeeef;
  }
</style>
