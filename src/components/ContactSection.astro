---
import { PERSON, type Locale } from '~/config/site';
import { useT } from '~/i18n';
import Icon from './Icon.astro';
import Mascot from './Mascot.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const s = t.story.contact;
// El correo no aparece en claro en el HTML: se monta en el navegador (contra el spam)
const [user = '', domain = ''] = PERSON.email.split('@');
---

<section class="contact container" id="contact" aria-labelledby="contact-title">
  <div class="contact__copy">
    <p class="tag">{s.eyebrow}</p>
    <h2 id="contact-title" class="contact__title">
      {s.title}
    </h2>
    <p class="contact__intro">{s.intro}</p>

    <div class="contact__actions">
      <a
        class="btn btn--primary contact__mail"
        data-email
        data-user={user}
        data-domain={domain}
        data-cursor="link"
        href="#contact"
      >
        <Icon name="mail" />
        <span data-email-text>{s.write}</span>
      </a>
      <button
        class="btn"
        type="button"
        data-copy-email
        data-copied={s.copied}
        data-cursor="link"
        hidden
      >
        {s.copy}
      </button>
      <a class="btn" href={PERSON.github} data-cursor="link">
        <Icon name="branch" />
        {s.github}
      </a>
    </div>
    <noscript>
      <p class="contact__noscript">{s.noscript}</p>
    </noscript>
  </div>

  <!-- Visor 3D de la patata (potato/contact.ts): decorativo; sin WebGL / reduced-motion queda la patata 2D -->
  <div class="viewer" data-potato-viewer aria-hidden="true">
    <i class="viewer__corner viewer__corner--tl"></i>
    <i class="viewer__corner viewer__corner--tr"></i>
    <i class="viewer__corner viewer__corner--bl"></i>
    <i class="viewer__corner viewer__corner--br"></i>
    <div class="viewer__fallback">
      <Mascot guide />
    </div>
    <div class="viewer__gl" data-viewer-gl></div>
    <p class="viewer__label viewer__label--tl">{s.viewerLabel}</p>
    <p class="viewer__label viewer__label--tr">{s.viewerMode}</p>
    <p class="viewer__label viewer__label--bl">
      <span>
        ROT X <b data-rot-x>+000.0°</b>
      </span>
      <span>
        ROT Y <b data-rot-y>+000.0°</b>
      </span>
      <span>
        ROT Z <b data-rot-z>+000.0°</b>
      </span>
    </p>
    <p class="viewer__label viewer__label--br">{s.viewerHint}</p>
  </div>
</section>

<style>
  .contact {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: var(--space-7);
    padding-block: var(--space-9) var(--space-8);
  }
  .contact__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  /* ── Visor 3D: recuadro técnico con marcas de esquina y lecturas en vivo ── */
  .viewer {
    position: relative;
    aspect-ratio: 5 / 4;
    min-width: 0;
    border: var(--border-w) solid var(--line-soft);
    background:
      radial-gradient(
        60% 55% at 50% 50%,
        color-mix(in srgb, var(--accent) 14%, transparent),
        transparent 75%
      ),
      linear-gradient(var(--line-soft) 1px, transparent 1px) 0 0 / 100% 2.5rem,
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px) 0 0 / 2.5rem 100%,
      color-mix(in srgb, var(--surface) 70%, transparent);
    background-blend-mode: normal, soft-light, soft-light, normal;
    overflow: clip;
    user-select: none;
    -webkit-user-select: none;
  }
  /* Líneas de la rejilla muy tenues, desvanecidas hacia los bordes */
  .viewer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(closest-side, transparent 45%, var(--bg) 120%);
    opacity: 0.85;
    pointer-events: none;
  }
  .viewer__corner {
    position: absolute;
    width: 0.9rem;
    height: 0.9rem;
    border: 0 solid var(--accent);
    pointer-events: none;
    z-index: 2;
  }
  .viewer__corner--tl {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }
  .viewer__corner--tr {
    top: -1px;
    right: -1px;
    border-width: 2px 2px 0 0;
  }
  .viewer__corner--bl {
    bottom: -1px;
    left: -1px;
    border-width: 0 0 2px 2px;
  }
  .viewer__corner--br {
    bottom: -1px;
    right: -1px;
    border-width: 0 2px 2px 0;
  }
  .viewer__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0 6%;
  }
  .viewer__fallback :global(.mascot) {
    width: 100%;
  }
  .viewer__gl {
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: grab;
    touch-action: pan-y; /* en táctil, el scroll vertical sigue funcionando */
  }
  .viewer__gl :global(canvas) {
    display: block;
    max-width: none;
  }
  .viewer[data-dragging] .viewer__gl {
    cursor: grabbing;
  }
  /* Con el WebGL listo, la patata 2D de reserva se oculta */
  .viewer[data-ready] .viewer__fallback {
    visibility: hidden;
  }
  .viewer__label {
    position: absolute;
    z-index: 2;
    margin: 0;
    display: grid;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .viewer__label b {
    font-weight: 500;
    color: var(--ink);
  }
  .viewer__label--tl {
    top: var(--space-4);
    left: var(--space-4);
  }
  .viewer__label--tr {
    top: var(--space-4);
    right: var(--space-4);
  }
  .viewer__label--bl {
    bottom: var(--space-4);
    left: var(--space-4);
  }
  .viewer__label--br {
    bottom: var(--space-4);
    right: var(--space-4);
    text-align: right;
  }
  .viewer__label--tl::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    background: var(--accent);
    margin-bottom: 0.2rem;
  }
  @media (max-width: 52rem) {
    .contact {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .viewer {
      aspect-ratio: 1 / 1;
    }
    .viewer__label--br {
      display: none;
    }
  }
  .contact__title {
    font-size: var(--text-hero);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .contact__intro {
    color: var(--ink-muted);
    font-size: var(--text-l);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .contact__noscript {
    font-family: var(--font-mono);
    font-size: var(--text-s);
    color: var(--ink-muted);
  }
</style>
