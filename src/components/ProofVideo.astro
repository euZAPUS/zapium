---
/**
 * «Prueba» de lo hecho: vídeo corto del autor usando su proyecto, dentro de un marco de
 * ventana. La misma pieza sirve, desenfocada y a pantalla completa, de fondo de la escena
 * (`backdrop`), mientras el «real» va delante. Los vídeos (WebM/MP4 comprimidos, mudos) viven
 * en public/videos/ y los genera scripts/optimize-videos.mjs. Sin vídeo, se ve un marcador
 * [TODO] visible. Autoplay solo al entrar en pantalla (scripts/story.ts); con
 * prefers-reduced-motion se queda el póster.
 */
interface Props {
  /** Texto del marcador cuando aún no hay vídeo */
  label: string;
  /** Rótulo de la barra de título de la ventana */
  title?: string;
  /** Nombre base en public/videos/ (sin extensión): NAME.webm, NAME.mp4, NAME.jpg */
  src?: string;
  backdrop?: boolean;
  class?: string;
}
const { label, title = '', src, backdrop = false, class: className } = Astro.props;
---

<div
  class:list={['proof', { 'proof--backdrop': backdrop }, className]}
  aria-hidden={backdrop ? 'true' : undefined}
>
  {!backdrop && (
    <div class="proof__bar">
      <i />
      <i />
      <i />
      <span>{title}</span>
    </div>
  )}
  <div class="proof__screen">
    {src ? (
      <video
        data-proof-video
        muted
        loop
        playsinline
        preload="none"
        poster={`/videos/${src}.jpg`}
        aria-label={backdrop ? undefined : label}
        tabindex="-1"
      >
        <source src={`/videos/${src}.webm`} type="video/webm" />
        <source src={`/videos/${src}.mp4`} type="video/mp4" />
      </video>
    ) : (
      <div class="proof__todo">
        <p>{backdrop ? '' : label}</p>
        <span class="proof__scan"></span>
      </div>
    )}
  </div>
</div>

<style>
  .proof {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--surface);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-hard-lg);
    overflow: hidden;
  }
  .proof__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.8rem;
    background: var(--bg-soft);
    border-bottom: var(--border-w) solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .proof__bar i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 2px solid var(--potato-line);
    background: var(--accent);
  }
  .proof__bar i:nth-child(2) {
    background: var(--pink);
  }
  .proof__bar i:nth-child(3) {
    background: var(--mint);
  }
  .proof__bar span {
    margin-inline-start: 0.4rem;
  }
  .proof__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #0e0c09;
  }
  .proof__screen video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  /* Marcador mientras no hay vídeo */
  .proof__todo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-5);
    text-align: center;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(246 239 226 / 0.05) 14px 28px),
      linear-gradient(160deg, #1d1812, #14110d);
  }
  .proof__todo p {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-mono);
    font-size: var(--text-s);
    line-height: 1.5;
    color: #f6efe2;
  }
  .proof__scan {
    position: absolute;
    inset-inline: 0;
    height: 18%;
    background: linear-gradient(to bottom, transparent, rgb(255 174 0 / 0.14), transparent);
    animation: scan 3.6s linear infinite;
  }
  @keyframes scan {
    from {
      top: -20%;
    }
    to {
      top: 100%;
    }
  }

  /* Versión de fondo: sin marco, a sangre y desenfocada */
  .proof--backdrop {
    position: absolute;
    inset: 0;
    display: block;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    background: none;
    filter: blur(34px) saturate(1.5) brightness(0.55);
  }
  /* En el tema claro el fondo desenfocado no se oscurece: queda un lavado pastel */
  :global(html[data-mode='light']) .proof--backdrop {
    filter: blur(34px) saturate(1.25) brightness(1.08);
  }
  .proof--backdrop .proof__todo {
    background:
      radial-gradient(40% 50% at 25% 30%, var(--accent), transparent 70%),
      radial-gradient(35% 45% at 75% 35%, var(--pink), transparent 70%),
      radial-gradient(45% 50% at 55% 80%, var(--sky), transparent 70%), var(--bg);
    background-size: 140% 140%;
    animation: drift 14s ease-in-out infinite alternate;
  }
  @keyframes drift {
    to {
      background-position: 100% 60%;
    }
  }
  .proof--backdrop .proof__screen {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .proof__scan,
    .proof--backdrop .proof__todo {
      animation: none;
    }
  }
</style>
