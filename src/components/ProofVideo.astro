---
/**
 * «Prueba» de lo hecho en formato estático (lista apilada de Works cuando no hay WebGL): vídeo
 * corto del autor dentro de un marco de ventana. Los vídeos (WebM/MP4 comprimidos, mudos) viven
 * en public/videos/ y los genera scripts/optimize-videos.mjs. Sin vídeo, se ve un marcador
 * [TODO] visible. Autoplay solo al entrar en pantalla (scripts/story.ts); con
 * prefers-reduced-motion se queda el póster. (En el carrusel WebGL el vídeo es una textura.)
 */
interface Props {
  /** Texto del marcador cuando aún no hay vídeo */
  label: string;
  /** Rótulo de la barra de título de la ventana */
  title?: string;
  /** Nombre base en public/videos/ (sin extensión): NAME.webm, NAME.mp4, NAME.jpg */
  src?: string;
  class?: string;
}
const { label, title = '', src, class: className } = Astro.props;
---

<div class:list={['proof', className]}>
  <div class="proof__bar">
    <i />
    <i />
    <i />
    <span>{title}</span>
  </div>
  <div class="proof__screen">
    {src ? (
      <video
        data-proof-video
        muted
        loop
        playsinline
        preload="none"
        poster={`/videos/${src}.jpg`}
        aria-label={label}
        tabindex="-1"
      >
        <source src={`/videos/${src}.webm`} type="video/webm" />
        <source src={`/videos/${src}.mp4`} type="video/mp4" />
      </video>
    ) : (
      <div class="proof__todo">
        <p>{label}</p>
        <span class="proof__scan"></span>
      </div>
    )}
  </div>
</div>

<style>
  .proof {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--surface);
    border: var(--border-w) solid var(--line-soft);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-hard-lg);
    overflow: hidden;
  }
  .proof__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.8rem;
    background: var(--bg-soft);
    border-bottom: var(--border-w) solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .proof__bar i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1px solid var(--ink-muted);
    background: transparent;
  }
  .proof__bar i:first-child {
    background: var(--accent);
    border-color: var(--accent);
  }
  .proof__bar span {
    margin-inline-start: 0.4rem;
  }
  .proof__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #050506;
  }
  .proof__screen video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  /* Marcador mientras no hay vídeo */
  .proof__todo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-5);
    text-align: center;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(238 238 239 / 0.05) 14px 28px),
      linear-gradient(160deg, #101012, #09090a);
  }
  .proof__todo p {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-mono);
    font-size: var(--text-s);
    line-height: 1.5;
    color: #eeeeef;
  }
  .proof__scan {
    position: absolute;
    inset-inline: 0;
    height: 18%;
    background: linear-gradient(to bottom, transparent, rgb(255 174 0 / 0.14), transparent);
    animation: scan 3.6s linear infinite;
  }
  @keyframes scan {
    from {
      top: -20%;
    }
    to {
      top: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proof__scan {
      animation: none;
    }
  }
</style>
