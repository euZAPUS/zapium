---
/**
 * La patata guía de las escenas: gira (3D) y cruza la pantalla con el scroll, y un
 * bocadillo explica la escena. Decorativa (aria-hidden): el texto real está en la página.
 * Cada sección la coloca y la coreografía con sus propias variables (--sp / --hp).
 */
import Mascot from './Mascot.astro';

interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
---

<div class:list={['guide', className]} data-guide aria-hidden="true">
  <div class="guide__spin">
    <Mascot guide />
  </div>
  <p class="guide__bubble">{text}</p>
</div>

<style>
  .guide {
    position: relative;
    pointer-events: none;
  }
  .guide__spin {
    filter: drop-shadow(0 0.6rem 0.5rem rgb(0 0 0 / 0.3));
  }
  .guide__bubble {
    position: absolute;
    left: 50%;
    bottom: 92%;
    translate: -50% 0;
    width: max-content;
    max-width: 13rem;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-m) var(--radius-m) var(--radius-m) 0.25rem;
    box-shadow: var(--shadow-hard);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.3;
  }
</style>
